<Window x:Class="FresAudio.Spotify.SpotifyDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Tải nhạc từ Spotify" Height="420" Width="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Foreground="{DynamicResource TextPrimary}"
        TextElement.Foreground="{DynamicResource TextPrimary}"
        ShowInTaskbar="False">
        
    <Window.Resources>
        <Style x:Key="WindowCloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bgBorder" Background="{TemplateBinding Background}" CornerRadius="0,15,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#F1707A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource BgWindow}" CornerRadius="15" BorderBrush="{DynamicResource BorderMain}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Title Bar -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Spotify" Foreground="#1DB954" Width="22" Height="22" VerticalAlignment="Center"/>
                    <TextBlock Text="TẢI NHẠC SPOTIFY" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                
                <Button HorizontalAlignment="Right" Width="45" Height="40" Style="{StaticResource WindowCloseButton}" Click="BtnClose_Click">
                    <materialDesign:PackIcon Kind="WindowClose" Width="16" Height="16"/>
                </Button>
            </Grid>

            <!-- Content Area -->
            <Grid Grid.Row="1" Margin="24,10,24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Input Section -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBox x:Name="txtUrl" Grid.Column="0" 
                             materialDesign:HintAssist.Hint="Dán đường dẫn Spotify vào đây..."
                             materialDesign:HintAssist.Foreground="{DynamicResource TextSecondary}"
                             materialDesign:HintAssist.IsFloating="False"
                             FontSize="15" Padding="2,6"
                             Foreground="{DynamicResource TextPrimary}"
                             CaretBrush="{DynamicResource TextPrimary}"
                             Margin="0,0,15,0" VerticalAlignment="Bottom"
                             KeyDown="TxtUrl_KeyDown"/>
                             
                    <Button x:Name="btnFetch" Grid.Column="1" Content="TÌM KIẾM" 
                            Style="{StaticResource MaterialDesignFlatDarkBgButton}"
                            Width="100" Height="36" VerticalAlignment="Bottom"
                            Click="BtnFetch_Click"
                            materialDesign:ButtonAssist.CornerRadius="6"/>
                </Grid>

                <!-- Folder Destination Selection Bar (To, rõ, dễ nhìn) -->
                <Border Grid.Row="1" Background="{DynamicResource ControlBg}" CornerRadius="9" Margin="0,12,0,0" Padding="14,0" Height="44" BorderBrush="{DynamicResource BorderMain}" BorderThickness="1">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                            <materialDesign:PackIcon Kind="FolderMusicOutline" Foreground="{DynamicResource AccentPrimary}" Width="20" Height="20" VerticalAlignment="Center"/>
                            <TextBlock Text="Lưu vào:" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <ComboBox x:Name="cboDestinationFolder" Grid.Column="1"
                                  VerticalAlignment="Center" FontSize="13.5" FontWeight="Medium"
                                  Padding="4,8"
                                  Foreground="{DynamicResource TextPrimary}"
                                  Background="Transparent" BorderThickness="0"
                                  materialDesign:TextFieldAssist.UnderlineBrush="Transparent"
                                  SelectionChanged="CboDestinationFolder_SelectionChanged"/>

                        <Button x:Name="btnBrowseFolder" Grid.Column="2" Click="BtnBrowseFolder_Click"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Height="32" Padding="12,0" Margin="10,0,0,0"
                                materialDesign:ButtonAssist.CornerRadius="6"
                                ToolTip="Chọn thư mục khác trên máy tính">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="FolderOpenOutline" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="Chọn thư mục..." Margin="5,0,0,0" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Info Panel -->
                <Border x:Name="infoPanel" Grid.Row="2" Margin="0,25,0,0" 
                        Background="{DynamicResource BgPanel}" CornerRadius="12" 
                        Visibility="Collapsed" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border CornerRadius="8" ClipToBounds="True" Width="100" Height="100" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#111111">
                            <Image x:Name="imgThumbnail" Stretch="UniformToFill"/>
                        </Border>
                        
                        <StackPanel Grid.Column="1" Margin="20,5,0,0">
                            <TextBlock x:Name="txtTitle" Text="Tên bài hát Spotify" FontSize="15" FontWeight="SemiBold" 
                                       TextWrapping="Wrap" MaxHeight="42" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="txtChannel" Text="Nghệ sĩ / Ca sĩ" FontSize="13" Foreground="{DynamicResource TextSecondary}" 
                                       Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <materialDesign:PackIcon Kind="ClockOutline" Foreground="{DynamicResource TextMuted}" Width="14" Height="14" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtDuration" Text="Thời lượng" FontSize="13" Foreground="{DynamicResource TextMuted}" 
                                           Margin="5,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Progress Section -->
                <StackPanel Grid.Row="3" Margin="0,20,0,0" x:Name="progressContainer">
                    <Border CornerRadius="4" Background="{DynamicResource BorderMain}" Height="8" ClipToBounds="True">
                        <ProgressBar x:Name="progressDownload" Height="8" Maximum="100" Background="Transparent" BorderThickness="0" materialDesign:TransitionAssist.DisableTransitions="True"/>
                    </Border>
                    <TextBlock x:Name="txtStatus" Margin="15,15,15,0" Text="" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="13"/>
                </StackPanel>

                <!-- Action Buttons -->
                <Grid Grid.Row="4" Margin="0,30,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button x:Name="btnCancel" Grid.Column="1" Content="HỦY" 
                            Style="{StaticResource MaterialDesignOutlinedButton}" 
                            Width="100" Height="36" Margin="0,0,15,0" 
                            materialDesign:ButtonAssist.CornerRadius="6"
                            Click="BtnCancel_Click"/>
                            
                    <Button x:Name="btnDownload" Grid.Column="2" Content="TẢI XUỐNG MP3" 
                            Style="{StaticResource MaterialDesignFlatDarkBgButton}"
                            Width="140" Height="36" IsEnabled="False" 
                            materialDesign:ButtonAssist.CornerRadius="6"
                            Click="BtnDownload_Click"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
