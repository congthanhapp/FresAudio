<Window x:Class="FresAudio.Youtube.YoutubeDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Tải nhạc từ YouTube" Height="600" Width="700" MinWidth="540" MinHeight="450"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Foreground="{DynamicResource TextPrimary}"
        TextElement.Foreground="{DynamicResource TextPrimary}"
        ShowInTaskbar="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="15" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>
        
    <Window.Resources>
        <Style x:Key="WindowCloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bgBorder" Background="{TemplateBinding Background}" CornerRadius="0,15,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#F1707A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuickChipStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BgPanel}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderMain}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="4,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="chipBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chipBorder" Property="Background" Value="{DynamicResource BgPanelHover}"/>
                                <Setter TargetName="chipBorder" Property="BorderBrush" Value="#FF0000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- No red border on selection, only on hover. 16px right margin for scrollbar spacing -->
        <Style x:Key="SearchResultItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,16,10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="itemBorder" Background="{DynamicResource BgPanel}" CornerRadius="10" Padding="12,10" BorderThickness="1" BorderBrush="{DynamicResource BorderMain}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource BgPanelHover}"/>
                                <Setter TargetName="itemBorder" Property="BorderBrush" Value="#FF0000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Elegant, compact Load More Button with clear text and bright theme -->
        <Style x:Key="LoadMoreButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BgPanel}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderMain}"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="17" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource BgPanelHover}"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#FF0000"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource BgPanel}"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#CC0000"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource BgWindow}" CornerRadius="15" BorderBrush="{DynamicResource BorderMain}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Title Bar -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Youtube" Foreground="#FF0000" Width="22" Height="22" VerticalAlignment="Center"/>
                    <TextBlock Text="TẢI NHẠC YOUTUBE" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                
                <Button HorizontalAlignment="Right" Width="45" Height="42" Style="{StaticResource WindowCloseButton}" Click="BtnClose_Click">
                    <materialDesign:PackIcon Kind="WindowClose" Width="16" Height="16"/>
                </Button>
            </Grid>

            <!-- Content Area -->
            <Grid Grid.Row="1" Margin="24,10,24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Input Section -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBox x:Name="txtUrl" Grid.Column="0" 
                             materialDesign:HintAssist.Hint="Nhập tên bài hát hoặc dán link YouTube..."
                             materialDesign:HintAssist.Foreground="{DynamicResource TextSecondary}"
                             materialDesign:HintAssist.IsFloating="False"
                             FontSize="15" Padding="2,6"
                             Foreground="{DynamicResource TextPrimary}"
                             CaretBrush="{DynamicResource TextPrimary}"
                             Margin="0,0,15,0" VerticalAlignment="Bottom"
                             KeyDown="TxtUrl_KeyDown"
                             TextChanged="TxtUrl_TextChanged"/>
                             
                    <Button x:Name="btnFetch" Grid.Column="1" Content="TÌM KIẾM" 
                            Style="{StaticResource MaterialDesignFlatDarkBgButton}"
                            Width="100" Height="36" VerticalAlignment="Bottom"
                            Click="BtnFetch_Click"
                            materialDesign:ButtonAssist.CornerRadius="6"/>
                </Grid>

                <!-- Folder Destination Selection Bar (To, rõ, dễ nhìn) -->
                <Border Grid.Row="1" Background="{DynamicResource ControlBg}" CornerRadius="9" Margin="0,12,0,0" Padding="14,0" Height="44" BorderBrush="{DynamicResource BorderMain}" BorderThickness="1">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                            <materialDesign:PackIcon Kind="FolderMusicOutline" Foreground="{DynamicResource AccentPrimary}" Width="20" Height="20" VerticalAlignment="Center"/>
                            <TextBlock Text="Lưu vào:" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <ComboBox x:Name="cboDestinationFolder" Grid.Column="1"
                                  VerticalAlignment="Center" FontSize="13.5" FontWeight="Medium"
                                  Padding="4,8"
                                  Foreground="{DynamicResource TextPrimary}"
                                  Background="Transparent" BorderThickness="0"
                                  materialDesign:TextFieldAssist.UnderlineBrush="Transparent"
                                  SelectionChanged="CboDestinationFolder_SelectionChanged"/>

                        <Button x:Name="btnBrowseFolder" Grid.Column="2" Click="BtnBrowseFolder_Click"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Height="32" Padding="12,0" Margin="10,0,0,0"
                                materialDesign:ButtonAssist.CornerRadius="6"
                                ToolTip="Chọn thư mục khác trên máy tính">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="FolderOpenOutline" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="Chọn thư mục..." Margin="5,0,0,0" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Middle Content Area -->
                <Grid Grid.Row="2" Margin="0,15,0,0">
                    <!-- 1. Initial Welcome / Suggestions State -->
                    <StackPanel x:Name="welcomePanel" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource BgPanel}" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <materialDesign:PackIcon Kind="Youtube" Width="36" Height="36" Foreground="#FF0000" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Tìm kiếm &amp; Tải nhạc YouTube" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="Nhập từ khóa bất kỳ hoặc dán link để tải bài hát MP3 chất lượng cao" FontSize="13" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                        
                        <TextBlock Text="GỢI Ý TÌM KIẾM NHANH" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,22,0,10"/>
                        <WrapPanel HorizontalAlignment="Center" MaxWidth="520">
                            <Button Content="🔥 Nhạc Trẻ Hot" Style="{StaticResource QuickChipStyle}" Click="BtnSuggestion_Click" Tag="Nhạc trẻ remix hot tiktok"/>
                            <Button Content="🎧 Lofi Chill" Style="{StaticResource QuickChipStyle}" Click="BtnSuggestion_Click" Tag="Lofi chill tiếng việt thư giãn"/>
                            <Button Content="✨ Acoustic Cover" Style="{StaticResource QuickChipStyle}" Click="BtnSuggestion_Click" Tag="Acoustic cover việt hay nhất"/>
                            <Button Content="🎵 EDM Remix" Style="{StaticResource QuickChipStyle}" Click="BtnSuggestion_Click" Tag="EDM bass boosted remix"/>
                            <Button Content="☕ Nhạc Không Lời" Style="{StaticResource QuickChipStyle}" Click="BtnSuggestion_Click" Tag="Nhạc không lời piano thư giãn"/>
                        </WrapPanel>
                    </StackPanel>

                    <!-- 2. Single Info Panel (Direct URL) -->
                    <Border x:Name="infoPanel" 
                            Background="{DynamicResource BgPanel}" CornerRadius="12" 
                            Visibility="Collapsed" Padding="18" VerticalAlignment="Top" BorderBrush="{DynamicResource BorderMain}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border CornerRadius="8" ClipToBounds="True" Width="150" Height="100" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#111111">
                                <Image x:Name="imgThumbnail" Stretch="UniformToFill"/>
                            </Border>
                            
                            <StackPanel Grid.Column="1" Margin="18,2,0,0">
                                <TextBlock x:Name="txtTitle" Text="Tiêu đề video" FontSize="15.5" FontWeight="SemiBold" 
                                           TextWrapping="Wrap" MaxHeight="45" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="txtChannel" Text="Kênh" FontSize="13.5" Foreground="{DynamicResource TextSecondary}" 
                                           Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <materialDesign:PackIcon Kind="ClockOutline" Foreground="{DynamicResource TextMuted}" Width="14" Height="14" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="txtDuration" Text="Thời lượng / Số bài" FontSize="13" Foreground="{DynamicResource TextMuted}" 
                                               Margin="5,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 3. Search Results Panel (YouTube Style Layout) -->
                    <Grid x:Name="searchPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="txtResultCount" Text="KẾT QUẢ TÌM KIẾM" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="2,0,0,8"/>
                        
                        <!-- Scrollable Container containing search cards and natural bottom Load More button -->
                        <ScrollViewer x:Name="scrollSearchResults" Grid.Row="1"
                                      Background="Transparent"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      PreviewMouseWheel="SearchResultsScrollViewer_PreviewMouseWheel">
                            <StackPanel Margin="0">
                                <ListBox x:Name="lstSearchResults" 
                                         Background="Transparent" BorderThickness="0" 
                                         Padding="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                         ItemContainerStyle="{StaticResource SearchResultItemStyle}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="144"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <!-- 16:9 Thumbnail with Duration Badge Overlay -->
                                                <Grid Width="144" Height="81" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <Border CornerRadius="8" ClipToBounds="True" Background="#111111">
                                                        <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="LowQuality"/>
                                                    </Border>
                                                    <Border Background="#D0000000" CornerRadius="4" Padding="5,2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4">
                                                        <TextBlock Text="{Binding DurationText}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                                    </Border>
                                                </Grid>
                                                
                                                <!-- Video Details (YouTube Style) -->
                                                <StackPanel Grid.Column="1" Margin="16,2,14,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" 
                                                               Foreground="{DynamicResource TextPrimary}"
                                                               TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="40"/>
                                                    
                                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                                                        <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource BgPanelHover}" Margin="0,0,7,0">
                                                            <materialDesign:PackIcon Kind="AccountCircle" Width="16" Height="16" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding Author}" FontSize="12.5" Foreground="{DynamicResource TextSecondary}" 
                                                                   TextTrimming="CharacterEllipsis" MaxWidth="240" VerticalAlignment="Center"/>
                                                        <materialDesign:PackIcon Kind="CheckCircle" Width="12" Height="12" Foreground="{DynamicResource TextMuted}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                
                                                <!-- Download Button -->
                                                <Button Grid.Column="2" 
                                                        Style="{StaticResource MaterialDesignFlatDarkBgButton}"
                                                        Height="36" Width="76" FontSize="12.5" Padding="0"
                                                        materialDesign:ButtonAssist.CornerRadius="6"
                                                        Click="BtnDownloadSearchResult_Click"
                                                        Tag="{Binding}"
                                                        VerticalAlignment="Center"
                                                        ToolTip="Tải bài hát này về">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <materialDesign:PackIcon Kind="Download" Width="15" Height="15" VerticalAlignment="Center"/>
                                                        <TextBlock Text="TẢI" Margin="4,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Load More Button positioned naturally below the last card -->
                                <Button x:Name="btnLoadMore"
                                        Style="{StaticResource LoadMoreButtonStyle}"
                                        HorizontalAlignment="Center"
                                        Margin="0,4,16,16"
                                        Visibility="Collapsed"
                                        Click="BtnLoadMore_Click"
                                        ToolTip="Xem thêm kết quả tìm kiếm">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon x:Name="iconLoadMore" Kind="ChevronDown" Width="16" Height="16" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="txtLoadMore" Text="Xem thêm" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- 4. Playlist Details Panel -->
                    <Grid x:Name="playlistPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Playlist Header Summary Card -->
                        <Border Background="{DynamicResource BgPanel}" CornerRadius="12" Padding="14,12" Margin="0,0,0,10" BorderBrush="{DynamicResource BorderMain}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border CornerRadius="8" ClipToBounds="True" Width="90" Height="60" HorizontalAlignment="Left" VerticalAlignment="Center" Background="#111111">
                                    <Image x:Name="imgPlaylistThumbnail" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="LowQuality"/>
                                </Border>
                                
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="txtPlaylistTitle" Text="Tiêu đề Playlist" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="txtPlaylistChannel" Text="Kênh tác giả" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <materialDesign:PackIcon Kind="PlaylistMusic" Foreground="{DynamicResource AccentPrimary}" Width="16" Height="16" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="txtPlaylistStats" Text="0 bài hát" FontSize="12.5" Foreground="{DynamicResource TextSecondary}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Playlist Songs List -->
                        <ListBox x:Name="lstPlaylistItems" Grid.Row="1" 
                                 Background="Transparent" BorderThickness="0" 
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 VirtualizingPanel.CacheLength="3,3"
                                 VirtualizingPanel.CacheLengthUnit="Page"
                                 PreviewMouseWheel="LstPlaylistItems_PreviewMouseWheel"
                                 ItemContainerStyle="{StaticResource SearchResultItemStyle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32"/>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Index -->
                                        <TextBlock Grid.Column="0" Text="{Binding Index, StringFormat='#{0:D2}'}" 
                                                   FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" 
                                                   VerticalAlignment="Center" HorizontalAlignment="Left"/>

                                        <!-- Thumbnail -->
                                        <Border Grid.Column="1" CornerRadius="6" ClipToBounds="True" Width="64" Height="42" Background="#111111" VerticalAlignment="Center">
                                            <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="LowQuality"/>
                                        </Border>

                                        <!-- Title and Author -->
                                        <StackPanel Grid.Column="2" Margin="12,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" 
                                                       Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding Author}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text=" • " FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                                                <TextBlock Text="{Binding DurationText}" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Status Badge -->
                                        <Border Grid.Column="3" CornerRadius="12" Padding="10,4" Background="{DynamicResource ControlBg}" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="{Binding StatusIcon}" Foreground="{Binding StatusColor}" Width="14" Height="14" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontSize="12" FontWeight="Medium" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Download Single Item Button -->
                                        <Button Grid.Column="4" 
                                                Style="{StaticResource MaterialDesignFlatDarkBgButton}"
                                                Height="30" Width="64" FontSize="11.5" Padding="0"
                                                materialDesign:ButtonAssist.CornerRadius="6"
                                                Click="BtnDownloadPlaylistItem_Click"
                                                Tag="{Binding}"
                                                IsEnabled="{Binding CanDownload}"
                                                Visibility="{Binding DownloadButtonVisibility}"
                                                VerticalAlignment="Center"
                                                ToolTip="Tải riêng bài hát này">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="Download" Width="13" Height="13" VerticalAlignment="Center"/>
                                                <TextBlock Text="TẢI" Margin="3,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>

                <!-- Progress Section -->
                <StackPanel Grid.Row="3" Margin="0,12,0,0" x:Name="progressContainer">
                    <Border CornerRadius="4" Background="{DynamicResource BorderMain}" Height="6" ClipToBounds="True">
                        <ProgressBar x:Name="progressDownload" Height="6" Maximum="100" Background="Transparent" BorderThickness="0" materialDesign:TransitionAssist.DisableTransitions="True"/>
                    </Border>
                    <TextBlock x:Name="txtStatus" Margin="10,10,10,0" Text="" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="13"/>
                </StackPanel>

                <!-- Action Buttons -->
                <Grid Grid.Row="4" Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button x:Name="btnCancel" Grid.Column="1" Content="ĐÓNG" 
                            Style="{StaticResource MaterialDesignOutlinedButton}" 
                            Width="100" Height="36" Margin="0,0,15,0" 
                            materialDesign:ButtonAssist.CornerRadius="6"
                            Click="BtnCancel_Click"/>

                    <Button x:Name="btnStopDownload" Grid.Column="2" 
                            Background="#e11d48" BorderBrush="#e11d48" Foreground="White"
                            Style="{StaticResource MaterialDesignFlatDarkBgButton}" 
                            Width="132" Height="36" Padding="8,0" Margin="0,0,15,0" 
                            materialDesign:ButtonAssist.CornerRadius="6"
                            Visibility="Collapsed"
                            Click="BtnStopDownload_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="StopCircleOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="DỪNG TẢI" Margin="6,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                            
                    <Button x:Name="btnDownload" Grid.Column="3" Content="TẢI XUỐNG MP3" 
