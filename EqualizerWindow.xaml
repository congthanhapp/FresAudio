<Window x:Class="FresAudio.EqualizerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Equalizer &amp; DSP Effects" Height="625" Width="780"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" MouseLeftButtonDown="Window_MouseLeftButtonDown"
        KeyDown="Window_KeyDown" ShowInTaskbar="False" ResizeMode="NoResize"
        Foreground="{DynamicResource TextPrimary}">

    <Window.Resources>
        <!-- Nút Đóng Chuẩn Phong Cách FresAudio -->
        <Style x:Key="WindowCloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bgBorder" Background="{TemplateBinding Background}" CornerRadius="0,15,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#F1707A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style Switch Bật/Tắt Tự Định Nghĩa Mượt Mà -->
        <Style x:Key="ModernSwitchToggleStyle" TargetType="CheckBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="switchBorder" Width="38" Height="20" CornerRadius="10" 
                                Background="{DynamicResource ControlBg}" 
                                BorderBrush="{DynamicResource BorderMain}" BorderThickness="1">
                            <Ellipse x:Name="switchThumb" Width="14" Height="14" 
                                     Fill="{DynamicResource TextSecondary}" 
                                     HorizontalAlignment="Left" Margin="2,0,0,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.3" Color="Black"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="switchBorder" Property="Background" Value="{DynamicResource AccentPrimary}"/>
                                <Setter TargetName="switchBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
                                <Setter TargetName="switchThumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="switchThumb" Property="Margin" Value="0,0,2,0"/>
                                <Setter TargetName="switchThumb" Property="Fill" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút Bo Tròn Chuẩn FresAudio -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BgPanel}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderMain}"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource ControlBg}"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource BgPanel}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Khung chính bo góc 15px đồng bộ toàn bộ app -->
    <Border CornerRadius="15" Background="{DynamicResource BgWindow}" ClipToBounds="True" BorderThickness="1" BorderBrush="{DynamicResource BorderMain}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="100"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="52"/>
            </Grid.RowDefinitions>

            <!-- 1. THANH TIÊU ĐỀ (HEADER) -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Tiêu đề & Icon -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <materialDesign:PackIcon Kind="Tune" Foreground="{DynamicResource AccentPrimary}" Width="20" Height="20" VerticalAlignment="Center"/>
                    <TextBlock Text="BỘ CHỈNH ÂM EQUALIZER &amp; DSP" Foreground="{DynamicResource TextPrimary}" 
                               FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>

                <!-- Preset ComboBox & Nút Đổi Tên & Nút Xóa Preset -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0">
                    <TextBlock Text="Preset:" Foreground="{DynamicResource TextSecondary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Border Background="{DynamicResource BgPanel}" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderMain}" Padding="6,0" VerticalAlignment="Center">
                        <ComboBox x:Name="cboPresets" Width="150" Height="28" 
                                  Foreground="{DynamicResource TextPrimary}" FontSize="12"
                                  BorderThickness="0" Background="Transparent"
                                  VerticalAlignment="Center"
                                  SelectionChanged="CboPresets_SelectionChanged"
                                  Cursor="Hand"/>
                    </Border>

                    <!-- Nút Đổi Tên Preset Tùy Chỉnh (chỉ hiện khi chọn Preset tự tạo) -->
                    <Button x:Name="btnRenamePreset" Style="{StaticResource MaterialDesignIconForegroundButton}" 
                            ToolTip="Đổi tên Preset này" Click="BtnRenamePreset_Click" 
                            Width="28" Height="28" Padding="0" Margin="4,0,0,0"
                            Foreground="{DynamicResource AccentPrimary}" Visibility="Collapsed">
                        <materialDesign:PackIcon Kind="PencilOutline" Width="16" Height="16"/>
                    </Button>

                    <!-- Nút Xóa Preset Tùy Chỉnh (chỉ hiện khi chọn Preset tự tạo) -->
                    <Button x:Name="btnDeletePreset" Style="{StaticResource MaterialDesignIconForegroundButton}" 
                            ToolTip="Xóa Preset này" Click="BtnDeletePreset_Click" 
                            Width="28" Height="28" Padding="0" Margin="2,0,0,0"
                            Foreground="#ef4444" Visibility="Collapsed">
                        <materialDesign:PackIcon Kind="TrashCanOutline" Width="16" Height="16"/>
                    </Button>
                </StackPanel>

                <!-- Nút Đóng Chuẩn Đỏ Hover -->
                <Button Grid.Column="2" Width="45" Height="44" Style="{StaticResource WindowCloseButton}" Click="BtnClose_Click" ToolTip="Đóng">
                    <materialDesign:PackIcon Kind="WindowClose" Width="16" Height="16"/>
                </Button>
            </Grid>

            <!-- 2. PHẠM VI ÁP DỤNG (SCOPE SELECTOR KÈM BỘ CHỌN BÀI HÁT / THƯ MỤC / PLAYLIST) -->
            <Border Grid.Row="1" Background="{DynamicResource BgPanelLeft}" Margin="18,0,18,4" CornerRadius="10" Padding="14,8" BorderThickness="1" BorderBrush="{DynamicResource BorderMain}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Dòng 1: Chọn phạm vi -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Áp dụng:" Foreground="{DynamicResource TextSecondary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <RadioButton x:Name="rbScopeGlobal" Content="Tất cả" GroupName="EqScope" Margin="0,0,14,0" Foreground="{DynamicResource TextPrimary}" Checked="RbScope_Checked" Cursor="Hand"/>
                        <RadioButton x:Name="rbScopeSong" Content="Theo bài hát" GroupName="EqScope" Margin="0,0,14,0" Foreground="{DynamicResource TextPrimary}" Checked="RbScope_Checked" Cursor="Hand"/>
                        <RadioButton x:Name="rbScopeFolder" Content="Theo thư mục" GroupName="EqScope" Margin="0,0,14,0" Foreground="{DynamicResource TextPrimary}" Checked="RbScope_Checked" Cursor="Hand"/>
                        <RadioButton x:Name="rbScopePlaylist" Content="Theo playlist" GroupName="EqScope" Margin="0,0,14,0" Foreground="{DynamicResource TextPrimary}" Checked="RbScope_Checked" Cursor="Hand"/>
                    </StackPanel>

                    <!-- Dòng 2: Bộ chọn đối tượng cụ thể (Dropdown Picker) -->
                    <Grid Grid.Row="1" x:Name="panelTargetPicker" Margin="0,6,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="lblPickerTitle" Grid.Column="0" Text="Chọn bài hát:" Foreground="{DynamicResource TextSecondary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>

                        <!-- Dropdown chọn Bài hát -->
                        <Border x:Name="borderSongPicker" Grid.Column="1" Background="{DynamicResource BgPanel}" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource BorderMain}" Padding="6,0" Visibility="Collapsed">
                            <ComboBox x:Name="cboSongPicker" Height="26" Foreground="{DynamicResource TextPrimary}" FontSize="12"
                                      BorderThickness="0" Background="Transparent" VerticalAlignment="Center"
                                      SelectionChanged="CboSongPicker_SelectionChanged" Cursor="Hand"/>
                        </Border>

                        <!-- Dropdown chọn Thư mục -->
                        <Border x:Name="borderFolderPicker" Grid.Column="1" Background="{DynamicResource BgPanel}" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource BorderMain}" Padding="6,0" Visibility="Collapsed">
                            <ComboBox x:Name="cboFolderPicker" Height="26" Foreground="{DynamicResource TextPrimary}" FontSize="12"
                                      BorderThickness="0" Background="Transparent" VerticalAlignment="Center"
                                      SelectionChanged="CboFolderPicker_SelectionChanged" Cursor="Hand"/>
                        </Border>

                        <!-- Dropdown chọn Playlist -->
                        <Border x:Name="borderPlaylistPicker" Grid.Column="1" Background="{DynamicResource BgPanel}" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource BorderMain}" Padding="6,0" Visibility="Collapsed">
                            <ComboBox x:Name="cboPlaylistPicker" Height="26" Foreground="{DynamicResource TextPrimary}" FontSize="12"
                                      BorderThickness="0" Background="Transparent" VerticalAlignment="Center"
                                      SelectionChanged="CboPlaylistPicker_SelectionChanged" Cursor="Hand"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- 3. MÀN HÌNH ĐƯỜNG CONG TẦN SỐ (SPLINE CURVE) VỚI CÁC MỐC dB RÕ NÉT -->
            <Border Grid.Row="2" Margin="18,4,18,4" Background="{DynamicResource BgPanel}" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource BorderMain}" ClipToBounds="True">
                <Grid>
                    <!-- Vạch lưới dB -->
                    <Grid Margin="48,0,16,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- +6dB -->
                        <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderMain}" Opacity="0.3"/>
                        <!-- 0dB (Vạch chuẩn làm nổi bật, có màu Accent nhẹ) -->
                        <Border Grid.Row="1" BorderThickness="0,0,0,1.5" BorderBrush="{DynamicResource AccentPrimary}" Opacity="0.65"/>
                        <!-- -6dB -->
                        <Border Grid.Row="2" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderMain}" Opacity="0.3"/>
                    </Grid>

                    <!-- Nhãn dB sắc nét, tương phản cao bên trái -->
                    <Grid VerticalAlignment="Stretch" HorizontalAlignment="Left" Width="46" Margin="6,0,0,0" IsHitTestVisible="False">
                        <!-- +12dB -->
                        <TextBlock Text="+12dB" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Top" Margin="0,2,0,0" HorizontalAlignment="Right"/>
                        <!-- +6dB -->
                        <TextBlock Text="+6dB" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,0,46" HorizontalAlignment="Right"/>
                        <!-- 0dB (Làm rõ và nổi bật nhất) -->
                        <Border Background="{DynamicResource ControlBg}" CornerRadius="4" Padding="3,1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,0,0">
                            <TextBlock Text="0 dB" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentPrimary}" HorizontalAlignment="Center"/>
                        </Border>
                        <!-- -6dB -->
                        <TextBlock Text="-6dB" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,46,0,0" HorizontalAlignment="Right"/>
                        <!-- -12dB -->
                        <TextBlock Text="-12dB" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Bottom" Margin="0,0,0,2" HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Canvas vẽ đường cong uốn lượn Bézier -->
                    <Canvas x:Name="canvasCurve" Margin="50,4,16,4" SizeChanged="CanvasCurve_SizeChanged"/>
                </Grid>
            </Border>

            <!-- 4. DÀN CẦN GẠT 10 BANDS + PREAMP (Chữ số dB rõ nét, tương phản cao) -->
            <Border Grid.Row="3" Margin="18,4,18,4" Background="{DynamicResource BgPanel}" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource BorderMain}" Padding="12,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="10*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Cột PREAMP -->
                    <Grid Grid.Column="0" Margin="0,0,6,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="txtPreampVal" Grid.Row="0" Text="0 dB" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimary}" HorizontalAlignment="Center"/>
                        <Slider x:Name="sliderPreamp" Grid.Row="1" Orientation="Vertical" Minimum="-12" Maximum="12" SmallChange="0.5" LargeChange="2"
                                Foreground="{DynamicResource AccentPrimary}" HorizontalAlignment="Center" Margin="0,4,0,4"
                                ValueChanged="SliderPreamp_ValueChanged" Cursor="Hand"
                                materialDesign:SliderAssist.OnlyShowFocusVisualWhileDragging="True"/>
                        <TextBlock Grid.Row="2" Text="Preamp" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                    </Grid>

                    <!-- Vạch phân cách -->
                    <Border Grid.Column="1" Background="{DynamicResource BorderMain}" Margin="0,8,0,8"/>

                    <!-- 10 CẦN GẠT TẦN SỐ -->
                    <Grid Grid.Column="2" x:Name="gridBands" Margin="6,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Band 0: 32Hz -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock x:Name="txtBand0" Text="0 dB" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                            <Slider x:Name="sliderBand0" Orientation="Vertical" Height="130" Minimum="-12" Maximum="12" SmallChange="0.5" LargeChange="2"
                                    Foreground="{DynamicResource AccentPrimary}" HorizontalAlignment="Center" Margin="0,4,0,4"
                                    ValueChanged="SliderBand_ValueChanged" Tag="0" Cursor="Hand"
                                    materialDesign:SliderAssist.OnlyShowFocusVisualWhileDragging="True"/>
                            <TextBlock Text="32Hz" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Band 1: 64Hz -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock x:Name="txtBand1" Text="0 dB" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                            <Slider x:Name="sliderBand1" Orientation="Vertical" Height="130" Minimum="-12" Maximum="12" SmallChange="0.5" LargeChange="2"
                                    Foreground="{DynamicResource AccentPrimary}" HorizontalAlignment="Center" Margin="0,4,0,4"
                                    ValueChanged="SliderBand_ValueChanged" Tag="1" Cursor="Hand"
                                    materialDesign:SliderAssist.OnlyShowFocusVisualWhileDragging="True"/>
                            <TextBlock Text="64Hz" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Band 2: 125Hz -->
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock x:Name="txtBand2" Text="0 dB" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                            <Slider x:Name="sliderBand2" Orientation="Vertical" Height="130" Minimum="-12" Maximum="12" SmallChange="0.5" LargeChange="2"
                                    Foreground="{DynamicResource AccentPrimary}" HorizontalAlignment="Center" Margin="0,4,0,4"
                                    ValueChanged="SliderBand_ValueChanged" Tag="2" Cursor="Hand"
                                    materialDesign:SliderAssist.OnlyShowFocusVisualWhileDragging="True"/>
                            <TextBlock Text="125Hz" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Band 3: 250Hz -->
                        <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                            <TextBlock x:Name="txtBand3" Text="0 dB" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                            <Slider x:Name="sliderBand3" Orientation="Vertical" Height="130" Minimum="-12" Maximum="12" SmallChange="0.5" LargeChange="2"
                                    Foreground="{DynamicResource AccentPrimary}" HorizontalAlignment="Center" Margin="0,4,0,4"
                                    ValueChanged="SliderBand_ValueChanged" Tag="3" Cursor="Hand"
                                    materialDesign:SliderAssist.OnlyShowFocusVisualWhileDragging="True"/>
                            <TextBlock Text="250Hz" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Band 4: 500Hz -->
                        <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                            <TextBlock x:Name="txtBand4" Text="0 dB" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                            <Slider x:Name="sliderBand4" Orientation="Vertical" Height="130" Minimum="-12" Maximum="12" SmallChange="0.5" LargeChange="2"
                                    Foreground="{DynamicResource AccentPrimary}" HorizontalAlignment="Center" Margin="0,4,0,4"
                                    ValueChanged="SliderBand_ValueChanged" Tag="4" Cursor="Hand"
                                    materialDesign:SliderAssist.OnlyShowFocusVisualWhileDragging="True"/>
                            <TextBlock Text="500Hz" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Band 5: 1kHz -->
                        <StackPanel Grid.Column="5" HorizontalAlignment="Center">
                            <TextBlock x:Name="txtBand5" Text="0 dB" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                            <Slider x:Name="sliderBand5" Orientation="Vertical" Height="130" Minimum="-12" Maximum="12" SmallChange="0.5" LargeChange="2"
                                    Foreground="{DynamicResource AccentPrimary}" HorizontalAlignment="Center" Margin="0,4,0,4"
                                    ValueChanged="SliderBand_ValueChanged" Tag="5" Cursor="Hand"
                                    materialDesign:SliderAssist.OnlyShowFocusVisualWhileDragging="True"/>
                            <TextBlock Text="1kHz" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Band 6: 2kHz -->
                        <StackPanel Grid.Column="6" HorizontalAlignment="Center">
                            <TextBlock x:Name="txtBand6" Text="0 dB" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                            <Slider x:Name="sliderBand6" Orientation="Vertical" Height="130" Minimum="-12" Maximum="12" SmallChange="0.5" LargeChange="2"
                                    Foreground="{DynamicResource AccentPrimary}" HorizontalAlignment="Center" Margin="0,4,0,4"
                                    ValueChanged="SliderBand_ValueChanged" Tag="6" Cursor="Hand"
                                    materialDesign:SliderAssist.OnlyShowFocusVisualWhileDragging="True"/>
                            <TextBlock Text="2kHz" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Band 7: 4kHz -->
                        <StackPanel Grid.Column="7" HorizontalAlignment="Center">
                            <TextBlock x:Name="txtBand7" Text="0 dB" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                            <Slider x:Name="sliderBand7" Orientation="Vertical" Height="130" Minimum="-12" Maximum="12" SmallChange="0.5" LargeChange="2"
                                    Foreground="{DynamicResource AccentPrimary}" HorizontalAlignment="Center" Margin="0,4,0,4"
                                    ValueChanged="SliderBand_ValueChanged" Tag="7" Cursor="Hand"
                                    materialDesign:SliderAssist.OnlyShowFocusVisualWhileDragging="True"/>
                            <TextBlock Text="4kHz" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Band 8: 8kHz -->
                        <StackPanel Grid.Column="8" HorizontalAlignment="Center">
                            <TextBlock x:Name="txtBand8" Text="0 dB" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                            <Slider x:Name="sliderBand8" Orientation="Vertical" Height="130" Minimum="-12" Maximum="12" SmallChange="0.5" LargeChange="2"
                                    Foreground="{DynamicResource AccentPrimary}" HorizontalAlignment="Center" Margin="0,4,0,4"
                                    ValueChanged="SliderBand_ValueChanged" Tag="8" Cursor="Hand"
                                    materialDesign:SliderAssist.OnlyShowFocusVisualWhileDragging="True"/>
                            <TextBlock Text="8kHz" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Band 9: 16kHz -->
                        <StackPanel Grid.Column="9" HorizontalAlignment="Center">
                            <TextBlock x:Name="txtBand9" Text="0 dB" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                            <Slider x:Name="sliderBand9" Orientation="Vertical" Height="130" Minimum="-12" Maximum="12" SmallChange="0.5" LargeChange="2"
                                    Foreground="{DynamicResource AccentPrimary}" HorizontalAlignment="Center" Margin="0,4,0,4"
                                    ValueChanged="SliderBand_ValueChanged" Tag="9" Cursor="Hand"
                                    materialDesign:SliderAssist.OnlyShowFocusVisualWhileDragging="True"/>
                            <TextBlock Text="16kHz" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- 5. HIỆU ỨNG DSP (BASS BOOST, 3D SURROUND, VOCAL CLARITY) -->
            <Border Grid.Row="4" Margin="18,4,18,4" Background="{DynamicResource BgPanel}" CornerRadius="10" Padding="14,8" BorderThickness="1" BorderBrush="{DynamicResource BorderMain}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Bass Boost -->
                    <StackPanel Grid.Column="0">
                        <Grid Margin="0,0,0,2">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Speaker" Width="15" Height="15" Foreground="{DynamicResource AccentPrimary}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Bass Boost" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="txtBassBoostVal" Text="0%" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Slider x:Name="sliderBassBoost" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10"
                                Foreground="{DynamicResource AccentPrimary}" Cursor="Hand" ValueChanged="SliderBassBoost_ValueChanged"
                                materialDesign:SliderAssist.OnlyShowFocusVisualWhileDragging="True"/>
                    </StackPanel>

                    <!-- 3D Surround -->
                    <StackPanel Grid.Column="2">
                        <Grid Margin="0,0,0,2">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Headphones" Width="15" Height="15" Foreground="{DynamicResource AccentPrimary}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="3D Surround" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="txtSurroundVal" Text="0%" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Slider x:Name="sliderSurround" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10"
                                Foreground="{DynamicResource AccentPrimary}" Cursor="Hand" ValueChanged="SliderSurround_ValueChanged"
                                materialDesign:SliderAssist.OnlyShowFocusVisualWhileDragging="True"/>
                    </StackPanel>

                    <!-- Vocal Clarity -->
                    <StackPanel Grid.Column="4">
                        <Grid Margin="0,0,0,2">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Microphone" Width="15" Height="15" Foreground="{DynamicResource AccentPrimary}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Vocal Clarity" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="txtVocalVal" Text="0%" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Slider x:Name="sliderVocal" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10"
                                Foreground="{DynamicResource AccentPrimary}" Cursor="Hand" ValueChanged="SliderVocal_ValueChanged"
                                materialDesign:SliderAssist.OnlyShowFocusVisualWhileDragging="True"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 6. THANH HÀNH ĐỘNG DƯỚI CÙNG (ACTION BAR VỚI NÚT RESET MẶC ĐỊNH RÕ RÀNG) -->
            <Grid Grid.Row="5" Margin="18,0,18,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <!-- NÚT RESET MẶC ĐỊNH CHO PRESET ĐANG CHỌN -->
                    <Button Style="{StaticResource ActionButtonStyle}" Click="BtnResetPreset_Click" ToolTip="Đặt lại các cần gạt về thông số chuẩn của Preset đang chọn" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Đặt lại mặc định" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- NÚT TẠO PRESET MỚI -->
                    <Button Style="{StaticResource ActionButtonStyle}" Click="BtnCreatePreset_Click" Margin="0,0,8,0" ToolTip="Lưu cấu hình hiện tại thành Preset mới trong thư viện">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="PlusBoxOutline" Width="15" Height="15" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Tạo Preset mới" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- NÚT XÓA TẤT CẢ PRESET -->
                    <Button x:Name="btnResetAllEq" Style="{StaticResource ActionButtonStyle}" Click="BtnResetAllEq_Click" Foreground="#ef4444" BorderBrush="#7fef4444" ToolTip="Xóa tất cả Preset tự tạo và khôi phục toàn bộ Equalizer về Flat">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="DeleteSweepOutline" Width="15" Height="15" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Xóa tất cả preset" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Nút Đóng / Xong -->
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Content="Xong" Click="BtnDone_Click"
                        Height="32" Padding="22,0" Background="{DynamicResource AccentPrimary}" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
