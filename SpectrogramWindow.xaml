<Window x:Class="FresAudio.SpectrogramWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Phổ âm thanh (Spectrogram)" Height="680" Width="1050" MinWidth="750" MinHeight="500"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" MouseLeftButtonDown="Window_MouseLeftButtonDown"
        KeyDown="Window_KeyDown" ResizeMode="CanResize" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        Foreground="{DynamicResource TextPrimary}" Icon="FresAudio.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CornerRadius="0" CaptionHeight="0" ResizeBorderThickness="7" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Nút Điều Khiển Window -->
        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource TitleBarBtnHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource TitleBarBtnPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút Đóng Window -->
        <Style x:Key="WindowCloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bgBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding ElementName=RootBorder, Path=CornerRadius}" Value="15,15,15,15">
                                <Setter TargetName="bgBorder" Property="CornerRadius" Value="0,14,0,0"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#F1707A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút Hành Động Hiện Đại -->
        <Style x:Key="ModernActionButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BgPanel}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderMain}"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource ControlBg}"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource BgPanel}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Khung chính bo góc 15px đồng bộ toàn bộ app -->
    <Border x:Name="RootBorder" CornerRadius="15" Background="{DynamicResource BgWindow}" ClipToBounds="True" BorderThickness="1" BorderBrush="{DynamicResource BorderMain}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Metadata Card & Actions -->
                <RowDefinition Height="*"/> <!-- Spectrogram Plot Area -->
                <RowDefinition Height="36"/> <!-- Status / Footer Bar -->
            </Grid.RowDefinitions>

            <!-- 1. THANH TIÊU ĐỀ (HEADER) -->
            <Border x:Name="bdrHeader" Grid.Row="0" Background="{DynamicResource BgPanelLeft}" CornerRadius="14,14,0,0">
                <Grid MouseLeftButtonDown="Window_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Tiêu đề & Icon -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                        <materialDesign:PackIcon Kind="Waveform" Foreground="{DynamicResource AccentPrimary}" Width="20" Height="20" VerticalAlignment="Center"/>
                        <TextBlock Text="QUANG PHỔ ÂM THANH (SPECTROGRAM)" Foreground="{DynamicResource TextPrimary}" 
                                   FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <TextBlock Text="• Phân tích tần số &amp; Kiểm tra dải âm" Foreground="{DynamicResource TextMuted}" 
                                   FontSize="11.5" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- Nút điều khiển cửa sổ -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch">
                        <Button Width="46" Click="BtnMinimize_Click" Style="{StaticResource WindowControlButton}" ToolTip="Thu nhỏ">
                            <TextBlock Text="&#xE921;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource TextPrimary}"/>
                        </Button>
                        <Button x:Name="btnMaximize" Width="46" Click="BtnMaximize_Click" Style="{StaticResource WindowControlButton}" ToolTip="Phóng to">
                            <TextBlock x:Name="iconMaximize" Text="&#xE922;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource TextPrimary}"/>
                        </Button>
                        <Button Width="46" Click="BtnClose_Click" Style="{StaticResource WindowCloseButton}" ToolTip="Đóng">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource TextPrimary}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. THANH THÔNG TIN BÀI HÁT & CÔNG CỤ -->
            <Border Grid.Row="1" Background="{DynamicResource BgPanel}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderMain}" Padding="20,10,20,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Thông tin tệp âm thanh -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="txtSongTitle" Text="Chưa mở tệp âm thanh nào" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                        
                        <WrapPanel Margin="0,5,0,0" Orientation="Horizontal">
                            <!-- Format badge -->
                            <Border x:Name="bdrFormat" Background="{DynamicResource ControlBg}" CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                                <TextBlock x:Name="txtFormat" Text="FLAC" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimary}"/>
                            </Border>
                            <!-- Sample rate badge -->
                            <Border Background="{DynamicResource ControlBg}" CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                                <TextBlock x:Name="txtSampleRate" Text="44.1 kHz" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                            </Border>
                            <!-- Bit depth / Bitrate -->
                            <Border Background="{DynamicResource ControlBg}" CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                                <TextBlock x:Name="txtBitrate" Text="960 kbps (16-bit)" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                            </Border>
                            <!-- Channels -->
                            <Border Background="{DynamicResource ControlBg}" CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                                <TextBlock x:Name="txtChannels" Text="Stereo" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                            </Border>
                            <!-- Duration -->
                            <Border Background="{DynamicResource ControlBg}" CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                                <TextBlock x:Name="txtDuration" Text="04:12" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                            </Border>
                            <!-- File size -->
                            <Border Background="{DynamicResource ControlBg}" CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                                <TextBlock x:Name="txtFileSize" Text="28.5 MB" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                            </Border>
                        </WrapPanel>
                    </StackPanel>

                    <!-- Các nút tác vụ -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="btnOpenCurrent" Style="{StaticResource ModernActionButton}" Margin="0,0,8,0" Click="BtnOpenCurrent_Click" ToolTip="Soi bài đang phát trong FresAudio">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="PlayCircleOutline" Width="16" Height="16" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentPrimary}"/>
                                <TextBlock Text="Bài đang phát" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnOpenFile" Style="{StaticResource ModernActionButton}" Margin="0,0,8,0" Click="BtnOpenFile_Click" ToolTip="Mở tệp âm thanh từ máy tính">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FolderOpenOutline" Width="16" Height="16" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock Text="Chọn tệp..." VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnExportImage" Style="{StaticResource ModernActionButton}" Click="BtnExportImage_Click" ToolTip="Lưu ảnh phổ âm thanh ra file PNG">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CameraOutline" Width="16" Height="16" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock Text="Lưu ảnh PNG" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. KHU VỰC VẼ PHỔ QUANG CHÍNH (SPECTROGRAM PLOT AREA) -->
            <Grid Grid.Row="2" Background="#0f0f11" Margin="0" SizeChanged="SpectrogramArea_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="65"/> <!-- Trục Tần số (Frequency Axis) -->
                    <ColumnDefinition Width="*"/>  <!-- Canvas Spectrogram -->
                    <ColumnDefinition Width="45"/> <!-- Thang đo cường độ dB (dB Legend) -->
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>   <!-- Vùng phổ -->
                    <RowDefinition Height="30"/>  <!-- Trục Thời gian (Time Axis) -->
                </Grid.RowDefinitions>

                <!-- Trục Tần số (Frequency Axis Canvas - Bên trái) -->
                <Canvas x:Name="canvasFreqAxis" Grid.Column="0" Grid.Row="0" Background="#141417" ClipToBounds="True"/>

                <!-- Vùng hiển thị ảnh Spectrogram & Crosshair -->
                <Grid Grid.Column="1" Grid.Row="0" x:Name="gridSpectrogramContainer" ClipToBounds="True"
                      MouseMove="Spectrogram_MouseMove" MouseLeave="Spectrogram_MouseLeave" Cursor="Cross">
                    
                    <!-- Ảnh Bitmap Spectrogram -->
                    <Image x:Name="imgSpectrogram" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>

                    <!-- Các đường vạch chỉ dẫn tần số nhạy cảm (16k, 20k, 22.05k) -->
                    <Canvas x:Name="canvasGuideLines" IsHitTestVisible="False"/>

                    <!-- Canvas Crosshair & Hover Tooltip -->
                    <Canvas x:Name="canvasOverlay" IsHitTestVisible="False">
                        <!-- Đường thẳng đứng theo chuột (Time) -->
                        <Line x:Name="lineCursorV" X1="0" Y1="0" X2="0" Y2="1000" Stroke="#66FFFFFF" StrokeThickness="1" StrokeDashArray="3,2" Visibility="Collapsed"/>
                        <!-- Đường nằm ngang theo chuột (Freq) -->
                        <Line x:Name="lineCursorH" X1="0" Y1="0" X2="2000" Y2="0" Stroke="#66FFFFFF" StrokeThickness="1" StrokeDashArray="3,2" Visibility="Collapsed"/>
                        
                        <!-- Badge Tooltip theo vị trí con trỏ -->
                        <Border x:Name="bdrHoverBadge" Background="#CC18181B" BorderBrush="{DynamicResource AccentPrimary}" BorderThickness="1" CornerRadius="6" Padding="8,4" Visibility="Collapsed">
                            <TextBlock x:Name="txtHoverInfo" Text="00:00 | 20,000 Hz | -12 dB" Foreground="White" FontSize="11.5" FontWeight="SemiBold"/>
                        </Border>
                    </Canvas>

                    <!-- Lớp phủ khi đang quét âm thanh (Loading Overlay) -->
                    <Grid x:Name="gridLoading" Background="#CC101014" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
                            <ProgressBar x:Name="progressBar" Height="6" Minimum="0" Maximum="100" Value="0" 
                                         Foreground="{DynamicResource AccentPrimary}" Background="{DynamicResource ControlBg}" BorderThickness="0"/>
                            <TextBlock x:Name="txtLoadingStatus" Text="Đang đọc và phân tích dải tần số FFT... 0%" 
                                       Foreground="{DynamicResource TextPrimary}" FontSize="12.5" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Lớp gợi ý Kéo thả file khi chưa có dữ liệu -->
                    <Grid x:Name="gridEmptyPlaceholder" Background="Transparent" Visibility="Visible" IsHitTestVisible="False">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="ChartTimelineVariant" Width="48" Height="48" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Opacity="0.5"/>
                            <TextBlock Text="Kéo &amp; thả tệp âm thanh (FLAC, MP3, WAV, ...) vào đây để soi phổ" 
                                       Foreground="{DynamicResource TextMuted}" FontSize="13.5" FontWeight="SemiBold" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Thang đo cường độ dB (dB Legend Bar - Bên phải) -->
                <Grid Grid.Column="2" Grid.Row="0" Background="#141417">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- Gradient dải màu dB -->
                    <Rectangle Grid.Column="0" Margin="2,4,2,4">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FFFFFF" Offset="0.0"/>   <!-- 0 dB: Trắng -->
                                <GradientStop Color="#FF1100" Offset="0.15"/>  <!-- -18 dB: Đỏ rực -->
                                <GradientStop Color="#FFAA00" Offset="0.35"/>  <!-- -42 dB: Cam/Vàng -->
                                <GradientStop Color="#00E5FF" Offset="0.60"/>  <!-- -72 dB: Xanh lơ -->
                                <GradientStop Color="#001188" Offset="0.85"/>  <!-- -102 dB: Xanh đậm -->
                                <GradientStop Color="#000000" Offset="1.0"/>   <!-- -120 dB: Đen -->
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <!-- Nhãn dB -->
                    <Canvas x:Name="canvasDbAxis" Grid.Column="1" ClipToBounds="True"/>
                </Grid>

                <!-- Trục Thời gian (Time Axis - Bên dưới) -->
                <Canvas x:Name="canvasTimeAxis" Grid.Column="1" Grid.Row="1" Background="#141417" ClipToBounds="True"/>
            </Grid>

            <!-- 4. THANH TRẠNG THÁI / FOOTER -->
            <Border x:Name="bdrFooter" Grid.Row="3" Background="{DynamicResource BgPanelLeft}" CornerRadius="0,0,14,14" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderMain}" Padding="20,0,20,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Chú thích các mốc tần số tiêu chuẩn -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#33FF5252" BorderBrush="#FF5252" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,10,0">
                            <TextBlock Text="16 kHz: MP3 128k Cutoff" FontSize="11" Foreground="#FF8080"/>
                        </Border>
                        <Border Background="#33FFB300" BorderBrush="#FFB300" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,10,0">
                            <TextBlock Text="20 kHz: MP3 320k Cutoff" FontSize="11" Foreground="#FFD54F"/>
                        </Border>
                        <Border Background="#3300E676" BorderBrush="#00E676" BorderThickness="1" CornerRadius="3" Padding="4,1">
                            <TextBlock Text="22.05 kHz: True Lossless (CD 44.1k)" FontSize="11" Foreground="#69F0AE"/>
                        </Border>
                    </StackPanel>

                    <!-- Thông báo trạng thái -->
                    <TextBlock x:Name="txtStatusMessage" Grid.Column="1" Text="Sẵn sàng" Foreground="{DynamicResource TextMuted}" FontSize="11.5" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,15,0"/>

                    <!-- Nút Đóng -->
                    <Button Grid.Column="2" Content="Đóng" Style="{StaticResource ModernActionButton}" Height="26" Padding="12,0" FontSize="11" Click="BtnClose_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
