<Window x:Class="FresAudio.FolderBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Chọn Thư Mục Nhạc" Height="500" Width="820"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border CornerRadius="15" Background="{DynamicResource BgWindow}" ClipToBounds="True" BorderThickness="1" BorderBrush="{DynamicResource AppBorder}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="70"/>
            </Grid.RowDefinitions>

            <!-- Thanh tiêu đề -->
            <Border Grid.Row="0" Background="{DynamicResource ControlBg}" CornerRadius="14,14,0,0">
                <Grid>
                    <TextBlock Text="CHỌN THƯ MỤC NHẠC" Foreground="{DynamicResource TextPrimary}" 
                               FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" Margin="20,0,0,0"/>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                            ToolTip="Đóng" Click="BtnCancel_Click"
                            Foreground="{DynamicResource TextMuted}" Background="Transparent" BorderThickness="0">
                        <materialDesign:PackIcon Kind="WindowClose" />
                    </Button>
                </Grid>
            </Border>

            <!-- Nội dung chính -->
            <Grid Grid.Row="1" Margin="20,20,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="1.5*"/>
                </Grid.ColumnDefinitions>

                <TreeView x:Name="treeFolders" Grid.Column="0" 
                          Background="Transparent" BorderThickness="0"
                          Foreground="{DynamicResource TextPrimary}"
                          SelectedItemChanged="TreeFolders_SelectedItemChanged"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <TreeView.ContextMenu>
                        <ContextMenu Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderMain}">
                            <MenuItem Header="Tạo thư mục con tại đây" Click="MenuItemNewFolder_Click"
                                      Foreground="{DynamicResource TextPrimary}">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="FolderPlusOutline" Foreground="{DynamicResource AccentPrimary}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </TreeView.ContextMenu>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Margin="2,8">
                                <materialDesign:PackIcon Kind="{Binding IconKind}" Foreground="{DynamicResource AccentPrimary}" Margin="0,0,8,0" VerticalAlignment="Center" Width="20" Height="20"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="14"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"/>

                <!-- Danh sách file nhạc bên phải -->
                <Border Grid.Column="2" Background="{DynamicResource ControlBg}" CornerRadius="8" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="txtFileCount" Text="0 bài hát" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,0,0,10"/>
                        <ListBox x:Name="lstFiles" Grid.Row="1" Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource TextPrimary}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,5">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="MusicNote" Foreground="{DynamicResource TextMuted}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding FileName}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <!-- Phần dưới cùng (Buttons & Path) -->
            <Grid Grid.Row="2" Background="{DynamicResource BgWindow}" Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,15,0">
                    <TextBlock x:Name="txtSelectedPath" Text="Chưa chọn thư mục nào" 
                               Foreground="{DynamicResource TextMuted}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <Button x:Name="btnNewFolder" Grid.Column="1" Click="BtnNewFolder_Click"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Height="36" Padding="12,0" Margin="0,0,10,0"
                        materialDesign:ButtonAssist.CornerRadius="6"
                        ToolTip="Tạo thư mục mới tại vị trí đang chọn">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="FolderPlusOutline" Width="16" Height="16" Foreground="{DynamicResource AccentPrimary}" VerticalAlignment="Center"/>
                        <TextBlock Text="Tạo thư mục mới" Margin="6,0,0,0" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="2" Content="HỦY" Width="90" Height="36" Margin="0,0,10,0"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        materialDesign:ButtonAssist.CornerRadius="6"
                        Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderMain}" Click="BtnCancel_Click"/>
                
                <Button Grid.Column="3" Content="CHỌN THƯ MỤC NÀY" Width="170" Height="36"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        materialDesign:ButtonAssist.CornerRadius="6"
                        Background="{DynamicResource AccentPrimary}" Foreground="White" Click="BtnSelect_Click"/>
            </Grid>

            <!-- Modal Tạo Thư Mục Mới -->
            <Grid x:Name="modalNewFolder" Grid.RowSpan="3" Background="#8A000000" Visibility="Collapsed">
                <Border Width="420" Background="{DynamicResource BgPanel}" CornerRadius="12" 
                        BorderBrush="{DynamicResource AppBorder}" BorderThickness="1"
                        Padding="22,20" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <materialDesign:PackIcon Kind="FolderPlusOutline" Foreground="{DynamicResource AccentPrimary}" Width="22" Height="22" VerticalAlignment="Center"/>
                            <TextBlock Text="TẠO THƯ MỤC MỚI" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock x:Name="txtParentFolderInfo" Text="Tạo trong: D:\Nhac" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,0,0,14"/>

                        <TextBox x:Name="txtNewFolderName"
                                 materialDesign:HintAssist.Hint="Nhập tên thư mục mới"
                                 materialDesign:HintAssist.Foreground="{DynamicResource TextSecondary}"
                                 FontSize="14" Padding="4,6"
                                 Foreground="{DynamicResource TextPrimary}"
                                 CaretBrush="{DynamicResource TextPrimary}"
                                 KeyDown="TxtNewFolderName_KeyDown"
                                 Margin="0,0,0,20"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <Button Grid.Column="1" Content="HỦY" 
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    materialDesign:ButtonAssist.CornerRadius="6"
                                    Height="34" Width="85" Margin="0,0,10,0"
                                    Click="BtnCancelNewFolder_Click"/>
                                    
                            <Button Grid.Column="2" Content="TẠO THƯ MỤC" 
                                    Style="{StaticResource MaterialDesignFlatDarkBgButton}"
                                    materialDesign:ButtonAssist.CornerRadius="6"
                                    Background="{DynamicResource AccentPrimary}"
                                    Foreground="White"
                                    Height="34" Padding="16,0"
                                    Click="BtnConfirmNewFolder_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>