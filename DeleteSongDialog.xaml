<Window x:Class="FresAudio.DeleteSongDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Tùy Chọn Xóa Bài Hát" Height="340" Width="480"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" MouseLeftButtonDown="Window_MouseLeftButtonDown"
        ShowInTaskbar="False">
    <Border CornerRadius="14" Background="{DynamicResource BgWindow}" ClipToBounds="True" BorderThickness="1" BorderBrush="{DynamicResource AppBorder}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="54"/>
            </Grid.RowDefinitions>

            <!-- Thanh tiêu đề -->
            <Border Grid.Row="0" Background="{DynamicResource ControlBg}" CornerRadius="13,13,0,0">
                <Grid Margin="16,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="DeleteAlertOutline" Foreground="{DynamicResource AccentPrimary}" Width="20" Height="20" VerticalAlignment="Center"/>
                        <TextBlock Text="XÁC NHẬN XÓA BÀI HÁT" Foreground="{DynamicResource TextPrimary}" 
                                   FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            ToolTip="Đóng (Esc)" Click="BtnCancel_Click"
                            Width="30" Height="30" Padding="0"
                            Style="{StaticResource MaterialDesignIconForegroundButton}"
                            Foreground="{DynamicResource TextSecondary}">
                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Nội dung lựa chọn -->
            <StackPanel Grid.Row="1" Margin="20,14,20,10">
                <!-- Tên bài hát -->
                <Border Background="{DynamicResource BgPanel}" CornerRadius="8" Padding="12,8" Margin="0,0,0,14" BorderBrush="{DynamicResource BorderMain}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="MusicNoteOutline" Foreground="{DynamicResource AccentPrimary}" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1" x:Name="txtSongName" Text="Tên bài hát..." 
                                   Foreground="{DynamicResource TextPrimary}" FontWeight="Medium" FontSize="13.5"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Lựa chọn 1: Xóa tạm khỏi danh sách -->
                <Button Click="BtnRemoveFromList_Click"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderMain}" BorderThickness="1"
                        Foreground="{DynamicResource TextPrimary}"
                        Height="56" Padding="14,0" Margin="0,0,0,10"
                        HorizontalContentAlignment="Stretch" Cursor="Hand"
                        materialDesign:ButtonAssist.CornerRadius="9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0" Kind="PlaylistRemove" Foreground="{DynamicResource AccentPrimary}" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Chỉ xóa khỏi danh sách phát" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="Ẩn khỏi app. File nhạc gốc trong ổ cứng vẫn giữ nguyên vẹn." FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <materialDesign:PackIcon Grid.Column="2" Kind="ChevronRight" Foreground="{DynamicResource TextMuted}" Width="20" Height="20" VerticalAlignment="Center"/>
                    </Grid>
                </Button>

                <!-- Lựa chọn 2: Xóa vĩnh viễn khỏi ổ cứng -->
                <Button Click="BtnDeleteFromDisk_Click"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="{DynamicResource BgPanel}" BorderBrush="#55FF5252" BorderThickness="1"
                        Foreground="{DynamicResource TextPrimary}"
                        Height="56" Padding="14,0"
                        HorizontalContentAlignment="Stretch" Cursor="Hand"
                        materialDesign:ButtonAssist.CornerRadius="9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0" Kind="DeleteForeverOutline" Foreground="#FF5252" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Xóa hẳn file nhạc ở ổ cứng" FontWeight="SemiBold" FontSize="13.5" Foreground="#FF5252"/>
                            <TextBlock Text="Xóa file âm thanh khỏi máy tính (chuyển vào Thùng rác)." FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <materialDesign:PackIcon Grid.Column="2" Kind="ChevronRight" Foreground="#FF5252" Width="20" Height="20" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
            </StackPanel>

            <!-- Nút Hủy dưới cùng -->
            <Border Grid.Row="2" Background="{DynamicResource ControlBg}" CornerRadius="0,0,13,13" Padding="16,0">
                <Grid>
                    <Button Content="HỦY BỎ" Click="BtnCancel_Click"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            materialDesign:ButtonAssist.CornerRadius="6"
                            BorderBrush="{DynamicResource BorderMain}"
                            Foreground="{DynamicResource TextSecondary}"
                            Height="34" Width="90" FontSize="12.5"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
