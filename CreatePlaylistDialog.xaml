<Window x:Class="FresAudio.CreatePlaylistDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Tạo Playlist" Height="540" Width="520"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" MouseLeftButtonDown="Window_MouseLeftButtonDown"
        ShowInTaskbar="False" Loaded="Window_Loaded">
    <Border CornerRadius="14" Background="{DynamicResource BgWindow}" ClipToBounds="True" BorderThickness="1" BorderBrush="{DynamicResource AppBorder}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="56"/>
            </Grid.RowDefinitions>

            <!-- Thanh tiêu đề -->
            <Border Grid.Row="0" Background="{DynamicResource ControlBg}" CornerRadius="13,13,0,0">
                <Grid Margin="16,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon x:Name="iconHeader" Kind="PlaylistPlus" Foreground="{DynamicResource AccentPrimary}" Width="20" Height="20" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtDialogTitle" Text="TẠO PLAYLIST MỚI" Foreground="{DynamicResource TextPrimary}" 
                                   FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            ToolTip="Đóng (Esc)" Click="BtnCancel_Click"
                            Width="30" Height="30" Padding="0"
                            Style="{StaticResource MaterialDesignIconForegroundButton}"
                            Foreground="{DynamicResource TextSecondary}">
                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Nhập tên Playlist -->
            <Border x:Name="pnlPlaylistName" Grid.Row="1" Padding="20,14,20,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderMain}">
                <StackPanel>
                    <TextBlock Text="Tên Playlist:" Foreground="{DynamicResource TextSecondary}" FontSize="12" FontWeight="Medium" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtPlaylistName"
                             materialDesign:HintAssist.Hint="Nhập tên playlist (VD: Nhạc Chill, Top Yêu Thích, Nhạc Tập Gym...)"
                             materialDesign:HintAssist.Foreground="{DynamicResource TextSecondary}"
                             FontSize="14" Padding="6,6"
                             Foreground="{DynamicResource TextPrimary}"
                             CaretBrush="{DynamicResource TextPrimary}"
                             KeyDown="TxtPlaylistName_KeyDown"/>
                </StackPanel>
            </Border>

            <!-- Phần chọn bài hát từ thư mục đang mở -->
            <Grid Grid.Row="2" x:Name="pnlSongSelection" Margin="20,10,20,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Thanh công cụ chọn bài & tìm kiếm -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox x:Name="chkSelectAll" Grid.Column="0" Content="Chọn tất cả" 
                              Foreground="{DynamicResource TextPrimary}" FontSize="12.5"
                              Cursor="Hand"
                              materialDesign:RippleAssist.IsDisabled="True"
                              VerticalAlignment="Center" Click="ChkSelectAll_Click"/>

                    <TextBlock x:Name="txtSelectedSummary" Grid.Column="2" 
                               Text="Đã chọn: 0 bài" Foreground="{DynamicResource AccentPrimary}" 
                               FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                </Grid>

                <!-- Danh sách bài hát có checkbox -->
                <Border Grid.Row="1" Background="{DynamicResource ControlBg}" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderMain}" ClipToBounds="True">
                    <ListBox x:Name="lstSelectableSongs" Background="Transparent" BorderThickness="0"
                             Padding="4" Foreground="{DynamicResource TextPrimary}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="6,6"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="itemBorder" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource ItemHoverBg}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Background="Transparent" MouseLeftButtonUp="SongItem_MouseLeftButtonUp">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              Focusable="False" IsHitTestVisible="False"
                                              materialDesign:RippleAssist.IsDisabled="True"
                                              VerticalAlignment="Center" Margin="0,0,10,0"/>

                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center" 
                                               Foreground="{DynamicResource TextPrimary}" FontSize="13" 
                                               TextTrimming="CharacterEllipsis"/>

                                    <Border Grid.Column="2" Background="{DynamicResource ItemHoverBg}" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding FolderName}" Foreground="{DynamicResource TextSecondary}" FontSize="11" MaxWidth="110" TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

            <!-- Nút điều khiển -->
            <Border Grid.Row="3" Background="{DynamicResource ControlBg}" CornerRadius="0,0,13,13" Padding="20,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="1" Content="HỦY" Click="BtnCancel_Click"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            materialDesign:ButtonAssist.CornerRadius="6"
                            BorderBrush="{DynamicResource BorderMain}"
                            Foreground="{DynamicResource TextSecondary}"
                            Height="36" Width="90" Margin="0,0,10,0" FontSize="13"/>

                    <Button Grid.Column="2" x:Name="btnConfirm" Content="TẠO PLAYLIST" Click="BtnConfirm_Click"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            materialDesign:ButtonAssist.CornerRadius="6"
                            Background="{DynamicResource AccentPrimary}"
                            Foreground="White"
                            Height="36" Padding="18,0" FontSize="13" FontWeight="SemiBold"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
