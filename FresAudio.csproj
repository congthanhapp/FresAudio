<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <NoWarn>$(NoWarn);CS8618;CS8600;CS8601;CS8602;CS8603;CS8604;CS8625;CS8622;CS4014</NoWarn>
    <ApplicationIcon>FresAudio.ico</ApplicationIcon>
    <Authors>Công Thành</Authors>
    <Company>Công Thành</Company>
    <Product>FresAudio</Product>
    <Copyright>Copyright © 2026 Công Thành</Copyright>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="Obfuscar" Version="2.2.50">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="SoundCloudExplode" Version="1.6.7" />
    <PackageReference Include="SoundTouch.Net" Version="2.3.2" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    <PackageReference Include="YoutubeExplode" Version="6.6.1" />
    <PackageReference Include="YoutubeDLSharp" Version="1.2.0" />
    <Resource Include="FresAudio.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Tools\yt-dlp.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <Target Name="ObfuscateBeforePublish" BeforeTargets="GenerateSingleFileBundle" Condition="'$(Configuration)' == 'Release'">
    <Message Importance="High" Text="[OBFUSCATION] Running Obfuscar on Release assembly..." />
    <Exec Command="obfuscar.console &quot;$(ProjectDir)obfuscar.xml&quot;" />
    <Copy SourceFiles="$(ProjectDir)bin\Release\net8.0-windows\win-x64\obfuscated\FresAudio.dll" DestinationFiles="$(IntermediateOutputPath)FresAudio.dll" />
    <Copy SourceFiles="$(ProjectDir)bin\Release\net8.0-windows\win-x64\obfuscated\FresAudio.dll" DestinationFiles="$(TargetDir)FresAudio.dll" />
    <Message Importance="High" Text="[OBFUSCATION] Obfuscated assembly successfully injected!" />
  </Target>

</Project>
