<Window x:Class="FresAudio.AddToPlaylistDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Thêm vào Playlist" Height="450" Width="440"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" MouseLeftButtonDown="Window_MouseLeftButtonDown"
        ShowInTaskbar="False">
    <Border CornerRadius="14" Background="{DynamicResource BgWindow}" ClipToBounds="True" BorderThickness="1" BorderBrush="{DynamicResource AppBorder}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="56"/>
            </Grid.RowDefinitions>

            <!-- Thanh tiêu đề -->
            <Border Grid.Row="0" Background="{DynamicResource ControlBg}" CornerRadius="13,13,0,0">
                <Grid Margin="16,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="PlaylistPlus" Foreground="{DynamicResource AccentPrimary}" Width="20" Height="20" VerticalAlignment="Center"/>
                        <TextBlock Text="THÊM VÀO PLAYLIST" Foreground="{DynamicResource TextPrimary}" 
                                   FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            ToolTip="Đóng (Esc)" Click="BtnCancel_Click"
                            Width="30" Height="30" Padding="0"
                            Style="{StaticResource MaterialDesignIconForegroundButton}"
                            Foreground="{DynamicResource TextSecondary}">
                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Thông tin bài hát / thư mục đang chọn -->
            <Border Grid.Row="1" Padding="16,10,16,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderMain}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="txtTargetType" Text="Bài hát đang chọn:" Foreground="{DynamicResource TextSecondary}" FontSize="11.5" FontWeight="Medium"/>
                        <TextBlock x:Name="txtTargetName" Text="Tên bài hát..." Foreground="{DynamicResource TextPrimary}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,8,0"/>
                    </StackPanel>

                    <Button Grid.Column="1" Click="BtnCreateNewPlaylist_Click"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Height="32" Padding="10,0" VerticalAlignment="Center"
                            Foreground="{DynamicResource AccentPrimary}" BorderBrush="{DynamicResource AccentPrimary}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Width="15" Height="15" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Tạo Mới" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Danh sách Playlist -->
            <Grid Grid.Row="2" Margin="16,10,16,10">
                <Border Background="{DynamicResource ControlBg}" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderMain}" ClipToBounds="True">
                    <Grid>
                        <!-- Danh sách khi có playlist -->
                        <ListBox x:Name="lstPlaylists" Background="Transparent" BorderThickness="0"
                                 Padding="4" Foreground="{DynamicResource TextPrimary}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="Margin" Value="0,1"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="itemBorder" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource ItemHoverBg}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid MouseLeftButtonUp="PlaylistItem_MouseLeftButtonUp" Background="Transparent">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                  materialDesign:RippleAssist.IsDisabled="True"
                                                  Margin="0,0,10,0" VerticalAlignment="Center"
                                                  Click="PlaylistCheckBox_Click"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding SongCountText}" Foreground="{DynamicResource TextSecondary}" FontSize="11.5" Margin="0,1,0,0"/>
                                        </StackPanel>

                                        <materialDesign:PackIcon Grid.Column="2" Kind="PlaylistMusicOutline" Foreground="{DynamicResource TextSecondary}" Width="18" Height="18" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Trạng thái chưa có Playlist nào -->
                        <StackPanel x:Name="pnlNoPlaylists" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                            <materialDesign:PackIcon Kind="PlaylistMusicOutline" Width="36" Height="36" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="Chưa có Playlist nào" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" FontSize="13.5" HorizontalAlignment="Center"/>
                            <TextBlock Text="Bấm nút 'Tạo Mới' ở trên để tạo Playlist đầu tiên" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Thanh nút bấm hành động -->
            <Border Grid.Row="3" Background="{DynamicResource ControlBg}" CornerRadius="0,0,13,13" Padding="16,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="txtSelectedSummary" Grid.Column="0" Text="Đã chọn: 0 playlist" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="HỦY" Click="BtnCancel_Click"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0"
                                Height="34" Width="75"/>
                        <Button x:Name="btnConfirm" Content="LƯU" Click="BtnConfirm_Click"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="{DynamicResource AccentPrimary}" Foreground="White"
                                BorderThickness="0" Height="34" Padding="16,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
