<Window x:Class="FresAudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="FresAudio" Height="620" Width="850" MinWidth="380" MinHeight="150"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" MouseLeftButtonDown="Window_MouseLeftButtonDown" PreviewKeyDown="Window_PreviewKeyDown" SizeChanged="Window_SizeChanged"
        Icon="FresAudio.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CornerRadius="0" CaptionHeight="0" ResizeBorderThickness="7" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource TitleBarBtnHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource TitleBarBtnPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bgBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding ElementName=RootBorder, Path=CornerRadius}" Value="15,15,15,15">
                                <Setter TargetName="bgBorder" Property="CornerRadius" Value="0,14,0,0"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#F1707A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" CornerRadius="15" Background="{DynamicResource BgWindow}" ClipToBounds="True" BorderThickness="1" BorderBrush="{DynamicResource AppBorder}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TitleBarRow" Height="32"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- TITLE BAR -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Window_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="15,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Image Source="FresAudio.ico" Width="16" Height="16" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="FresAudio" Foreground="{DynamicResource TextPrimary}" FontSize="12" Margin="5,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBlock Text="• by Công Thành" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" Opacity="0.75"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch">
                    <Button Width="46" Click="BtnMinimize_Click" Style="{StaticResource WindowControlButton}" ToolTip="Thu nhỏ">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource TextPrimary}"/>
                    </Button>
                    <Button x:Name="btnMaximize" Width="46" Click="BtnMaximize_Click" Style="{StaticResource WindowControlButton}" ToolTip="Phóng to">
                        <TextBlock x:Name="iconMaximize" Text="&#xE922;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource TextPrimary}"/>
                    </Button>
                    <Button Width="46" Click="BtnClose_Click" Style="{StaticResource WindowCloseButton}" ToolTip="Đóng">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource TextPrimary}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Nửa trên: Bảng trái & Bảng phải -->
            <Grid Grid.Row="1" x:Name="mainContentGrid" ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="0"/>
                </Grid.RowDefinitions>

                <!-- BẢNG BÊN TRÁI -->
                <Border x:Name="leftPanel" Grid.Column="0" Grid.Row="0" Background="{DynamicResource BgPanelLeft}" CornerRadius="0" Padding="20,20,20,0">
                    <Grid Margin="0,-20,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/> <!-- Top Spacer -->
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/> <!-- Bottom Spacer -->
                        </Grid.RowDefinitions>

                        <!-- Ảnh Bìa -->
                        <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" Margin="0,10,0,10" VerticalAlignment="Center">
                            <Border x:Name="bdrAlbumArt" Width="240" Height="240" CornerRadius="15" 
                                    Background="{DynamicResource BgPanel}" HorizontalAlignment="Center">
                                <Grid>
                                    <Image x:Name="imgAlbumArt" Stretch="UniformToFill">
                                        <Image.Clip>
                                            <RectangleGeometry x:Name="clipAlbumArt" RadiusX="15" RadiusY="15" Rect="0,0,240,240"/>
                                        </Image.Clip>
                                    </Image>
                                </Grid>
                            </Border>
                        </Viewbox>

                        <!-- Tên bài hát -->
                        <TextBlock x:Name="txtTitle" Grid.Row="2" Text="Chưa chọn bài hát" 
                                   FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" 
                                   TextAlignment="Center" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            
                            <!-- Ca sĩ -->
                            <TextBlock x:Name="txtArtist" Grid.Row="3" Text="Unknown Artist" 
                                       FontSize="14" Foreground="{DynamicResource TextSecondary}" 
                                       TextAlignment="Center" Margin="0,5,0,5" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>

                            <!-- Thông tin nhạc -->
                            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                                <Border Background="{DynamicResource BgPanel}" CornerRadius="4" Padding="6,2" Margin="0,0,5,0" BorderThickness="1" BorderBrush="{DynamicResource AppBorder}">
                                    <TextBlock x:Name="txtFormat" Text="---" FontSize="11" Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold"/>
                                </Border>
                                <Border Background="{DynamicResource BgPanel}" CornerRadius="4" Padding="6,2" Margin="0,0,5,0" BorderThickness="1" BorderBrush="{DynamicResource AppBorder}">
                                    <TextBlock x:Name="txtBitrate" Text="--- kbps" FontSize="11" Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold"/>
                                </Border>
                                <Border Background="{DynamicResource BgPanel}" CornerRadius="4" Padding="6,2" Margin="0,0,5,0" BorderThickness="1" BorderBrush="{DynamicResource AppBorder}">
                                    <TextBlock x:Name="txtSampleRate" Text="--- kHz" FontSize="11" Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold"/>
                                </Border>
                                <Border Background="{DynamicResource BgPanel}" CornerRadius="4" Padding="6,2" BorderThickness="1" BorderBrush="{DynamicResource AppBorder}">
                                    <TextBlock x:Name="txtFileSize" Text="--- MB" FontSize="11" Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>

                            <!-- Sóng nhạc (Visualizer) -->
                            <Canvas x:Name="canvasVisualizer" Grid.Row="5" Width="256" Height="60" Margin="0,20,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" ClipToBounds="True" Cursor="Hand" ToolTip="Bấm để xem phổ âm thanh chi tiết (Spectrogram)" MouseLeftButtonUp="CanvasVisualizer_MouseLeftButtonUp">
                            </Canvas>
                        </Grid>
                </Border>

                <!-- BẢNG BÊN PHẢI -->
                <Grid x:Name="rightPanel" Grid.Column="1" Grid.Row="0" Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="btnYoutube" Style="{StaticResource MaterialDesignIconForegroundButton}" 
                                    Width="40" Height="40"
                                    ToolTip="Tải nhạc MP3 từ YouTube" Click="BtnYoutube_Click">
                                <materialDesign:PackIcon Kind="Youtube" Foreground="#FF0000" Width="22" Height="22"/>
                            </Button>
                            <Button x:Name="btnSpotify" Style="{StaticResource MaterialDesignIconForegroundButton}" 
                                    Width="40" Height="40" Margin="5,0,0,0"
                                    ToolTip="Tải nhạc MP3 từ Spotify" Click="BtnSpotify_Click">
                                <materialDesign:PackIcon Kind="Spotify" Foreground="#1DB954" Width="22" Height="22"/>
                            </Button>
                            <Button x:Name="btnSoundcloud" Style="{StaticResource MaterialDesignIconForegroundButton}" 
                                    Width="40" Height="40" Margin="5,0,0,0"
                                    ToolTip="Tải nhạc MP3 từ SoundCloud" Click="BtnSoundcloud_Click">
                                <materialDesign:PackIcon Kind="Soundcloud" Foreground="#FF5500" Width="22" Height="22"/>
                            </Button>
                            <Button x:Name="btnTiktok" Style="{StaticResource MaterialDesignIconForegroundButton}" 
                                    Width="40" Height="40" Margin="5,0,0,0"
                                    ToolTip="Tải nhạc MP3 từ TikTok" Click="BtnTiktok_Click">
                                <Viewbox Width="20" Height="20">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="{DynamicResource TextPrimary}" Data="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64c.298-.002.595.042.88.13V9.4a6.33 6.33 0 0 0-1-.08A6.34 6.34 0 0 0 3 15.66a6.34 6.34 0 0 0 10.82 4.49 6.28 6.28 0 0 0 1.87-4.49V8.69a8.18 8.18 0 0 0 4.9 1.6V6.85a4.85 4.85 0 0 1-1-.16z"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <!-- Nút Equalizer (Đồng bộ phong cách thanh công cụ) -->
                            <Button x:Name="btnEqualizer" Style="{StaticResource MaterialDesignIconForegroundButton}" 
                                    ToolTip="Bộ chỉnh âm Equalizer &amp; Hiệu ứng DSP (EQ)" Click="BtnEqualizer_Click" 
                                    Margin="5,0,0,0" Width="40" Height="40">
                                <materialDesign:PackIcon Kind="Tune" Foreground="{DynamicResource TextPrimary}" Width="20" Height="20"/>
                            </Button>
                            <!-- Nút Phổ âm thanh Spectrogram -->
                            <Button x:Name="btnSpectrogram" Style="{StaticResource MaterialDesignIconForegroundButton}" 
                                    ToolTip="Xem phổ âm thanh (Spectrogram)" Click="BtnSpectrogram_Click" 
                                    Margin="5,0,0,0" Width="40" Height="40">
                                <materialDesign:PackIcon Kind="Waveform" Foreground="{DynamicResource TextPrimary}" Width="20" Height="20"/>
                            </Button>
                            <Button Style="{StaticResource MaterialDesignIconForegroundButton}" ToolTip="Chuyển chế độ Sáng/Tối" Click="BtnToggleTheme_Click" Margin="5,0,0,0" Width="40" Height="40">
                                <materialDesign:PackIcon x:Name="iconTheme" Kind="WeatherSunny" Foreground="{DynamicResource TextPrimary}" Width="20" Height="20"/>
                            </Button>
                        </StackPanel>

                        <Grid Grid.Column="1" Margin="20,0,15,0" Height="40" VerticalAlignment="Top" HorizontalAlignment="Left">
                            <Border Background="{DynamicResource BgPanel}" CornerRadius="8" />
                            <materialDesign:PackIcon Kind="Speaker" Foreground="{DynamicResource TextSecondary}" Width="20" Height="20" VerticalAlignment="Center" Margin="15,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                            <ComboBox x:Name="cboAudioDevices" MinWidth="130" MaxWidth="300"
                                      Padding="45,10,10,10"
                                      VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" 
                                      BorderThickness="0" Background="Transparent"
                                      materialDesign:TextFieldAssist.UnderlineBrush="Transparent"
                                      SelectionChanged="CboAudioDevices_SelectionChanged">

                            </ComboBox>
                        </Grid>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                        </StackPanel>
                    </Grid>

                    <!-- Row 1: Tìm kiếm bài hát -->
                    <Border Grid.Row="1" Background="{DynamicResource BgPanel}" CornerRadius="8" Margin="0,15,15,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Magnify" Foreground="{DynamicResource TextSecondary}" Width="20" Height="20" VerticalAlignment="Center" Margin="15,0,0,0"/>
                            <TextBox x:Name="txtSearch" Grid.Column="1" 
                                     materialDesign:HintAssist.Hint="Tìm kiếm bài hát..." 
                                     Foreground="{DynamicResource TextPrimary}"
                                     BorderThickness="0" Background="Transparent" Padding="10,10,10,10"
                                     materialDesign:TextFieldAssist.UnderlineBrush="Transparent"
                                     TextChanged="TxtSearch_TextChanged"/>
                            <Button x:Name="btnSearchClear" Grid.Column="2" Click="BtnSearchClear_Click"
                                    Width="28" Height="28" Margin="0,0,6,0" Padding="0"
                                    Style="{StaticResource MaterialDesignIconForegroundButton}"
                                    Visibility="Collapsed" ToolTip="Xóa tìm kiếm">
                                <materialDesign:PackIcon Kind="CloseCircle" Width="16" Height="16" Foreground="{DynamicResource TextSecondary}"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Row 2: Thanh Tab PLAYLIST (Nằm ở giữa Tìm kiếm và Thư mục) -->
                    <Border x:Name="gridPlaylistTabs" Grid.Row="2" Margin="0,8,15,0"
                            Background="{DynamicResource BgPanel}" CornerRadius="8"
                            BorderBrush="{DynamicResource BorderMain}" BorderThickness="1"
                            Padding="3,3,3,3" Height="40">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="btnScrollPlaylistsLeft" Grid.Column="0" Click="BtnScrollPlaylistsLeft_Click"
                                    Width="24" Height="28" Margin="0,0,3,0" Padding="0"
                                    Style="{StaticResource MaterialDesignIconForegroundButton}"
                                    Visibility="Collapsed" ToolTip="Cuộn playlist sang trái">
                                <materialDesign:PackIcon Kind="ChevronLeft" Width="18" Height="18" Foreground="{DynamicResource TextSecondary}"/>
                            </Button>

                            <ScrollViewer x:Name="scrollPlaylistTabs" Grid.Column="1"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                          PreviewMouseWheel="PlaylistTabsScrollViewer_PreviewMouseWheel"
                                          ScrollChanged="ScrollPlaylistTabs_ScrollChanged"
                                          Focusable="False" PanningMode="HorizontalOnly">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ItemsControl x:Name="itemsPlaylistTabs">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,4,0" Height="30" CornerRadius="6"
                                                        ToolTip="{Binding ToolTipText}"
                                                        ContextMenuOpening="PlaylistTab_ContextMenuOpening"
                                                        MouseLeftButtonDown="PlaylistTab_MouseLeftButtonDown">
                                                    <Border.ContextMenu>
                                                        <ContextMenu ContextMenuOpening="PlaylistTab_ContextMenuOpening" Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderMain}">
                                                            <MenuItem Header="Thêm nhạc..." Click="MenuTabAddSongs_Click" Foreground="{DynamicResource TextPrimary}">
                                                                <MenuItem.Icon>
                                                                    <materialDesign:PackIcon Kind="PlaylistMusicOutline" Foreground="{DynamicResource AccentPrimary}"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="Đổi tên Playlist..." Click="MenuTabRenamePlaylist_Click" Foreground="{DynamicResource TextPrimary}">
                                                                <MenuItem.Icon>
                                                                    <materialDesign:PackIcon Kind="RenameBox" Foreground="{DynamicResource AccentPrimary}"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="Cài đặt Equalizer (EQ)..." Click="MenuTabPlaylistEqualizer_Click" Foreground="{DynamicResource TextPrimary}">
                                                                <MenuItem.Icon>
                                                                    <materialDesign:PackIcon Kind="Equalizer" Foreground="{DynamicResource AccentPrimary}"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="Xóa Playlist này" Click="MenuTabDeletePlaylist_Click" Foreground="#FF5252">
                                                                <MenuItem.Icon>
                                                                    <materialDesign:PackIcon Kind="TrashCanOutline" Foreground="#FF5252"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                        </ContextMenu>
                                                    </Border.ContextMenu>
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                                            <Setter Property="Cursor" Value="Hand"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsAllTab}" Value="True">
                                                                    <Setter Property="Cursor" Value="Arrow"/>
                                                                    <Setter Property="Background" Value="Transparent"/>
                                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                                    <Setter Property="ContextMenu" Value="{x:Null}"/>
                                                                </DataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsAllTab}" Value="False"/>
                                                                        <Condition Binding="{Binding IsSelected}" Value="True"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Background" Value="{DynamicResource ControlBg}"/>
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
                                                                </MultiDataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsAllTab}" Value="False"/>
                                                                        <Condition Binding="{Binding IsSelected}" Value="False"/>
                                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Background" Value="{DynamicResource ItemHoverBg}"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>

                                                    <Grid VerticalAlignment="Center" Margin="8,0,8,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <materialDesign:PackIcon Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0" Width="16" Height="16">
                                                            <materialDesign:PackIcon.Style>
                                                                <Style TargetType="materialDesign:PackIcon">
                                                                    <Setter Property="Kind" Value="PlaylistMusicOutline"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsAllTab}" Value="True">
                                                                            <Setter Property="Kind" Value="PlaylistPlay"/>
                                                                            <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}"/>
                                                                        </DataTrigger>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding IsAllTab}" Value="False"/>
                                                                                <Condition Binding="{Binding IsSelected}" Value="True"/>
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}"/>
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </materialDesign:PackIcon.Style>
                                                        </materialDesign:PackIcon>

                                                        <TextBlock Grid.Column="1" Text="{Binding HeaderName}" VerticalAlignment="Center" FontSize="13" MaxWidth="140" TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                                                    <Setter Property="FontWeight" Value="Medium"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsAllTab}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                                        </DataTrigger>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding IsAllTab}" Value="False"/>
                                                                                <Condition Binding="{Binding IsSelected}" Value="True"/>
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                        <Border Grid.Column="2" Margin="6,0,0,0" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource ControlBg}"/>
                                                                    <Setter Property="BorderThickness" Value="1"/>
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding IsAllTab}" Value="False"/>
                                                                                <Condition Binding="{Binding IsSelected}" Value="True"/>
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Background" Value="{DynamicResource AccentPrimary}"/>
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding SongCount}" FontSize="11" FontWeight="Bold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                                                        <Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding IsAllTab}" Value="False"/>
                                                                                    <Condition Binding="{Binding IsSelected}" Value="True"/>
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Foreground" Value="White"/>
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>

                                                        <materialDesign:PackIcon Grid.Column="3" Kind="VolumeHigh" Width="14" Height="14" Margin="5,0,0,0" VerticalAlignment="Center">
                                                            <materialDesign:PackIcon.Style>
                                                                <Style TargetType="materialDesign:PackIcon">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}"/>
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding IsAllTab}" Value="False"/>
                                                                                <Condition Binding="{Binding IsPlaying}" Value="True"/>
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </materialDesign:PackIcon.Style>
                                                        </materialDesign:PackIcon>

                                                        <Button Grid.Column="4" Click="BtnClosePlaylistTab_Click" Margin="5,0,0,0" Width="18" Height="18" Padding="0"
                                                                ToolTip="Xóa Playlist này">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconForegroundButton}">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsAllTab}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <materialDesign:PackIcon Kind="Close" Width="12" Height="12" Foreground="{DynamicResource TextMuted}"/>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Nút [+] Tạo Playlist Mới -->
                                    <Button x:Name="btnAddPlaylistTab" Click="BtnCreatePlaylist_Click"
                                            Width="28" Height="28" Margin="2,0,2,0" Padding="0"
                                            Style="{StaticResource MaterialDesignIconForegroundButton}"
                                            ToolTip="Tạo Playlist mới">
                                        <materialDesign:PackIcon Kind="PlaylistPlus" Foreground="{DynamicResource AccentPrimary}" Width="17" Height="17"/>
                                    </Button>
                                </StackPanel>
                            </ScrollViewer>

                            <Button x:Name="btnScrollPlaylistsRight" Grid.Column="2" Click="BtnScrollPlaylistsRight_Click"
                                    Width="24" Height="28" Margin="3,0,0,0" Padding="0"
                                    Style="{StaticResource MaterialDesignIconForegroundButton}"
                                    Visibility="Collapsed" ToolTip="Cuộn playlist sang phải">
                                <materialDesign:PackIcon Kind="ChevronRight" Width="18" Height="18" Foreground="{DynamicResource TextSecondary}"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Row 3: Thanh Tab Thư Mục Phong Cách Google Chrome / Fluent -->
                    <Border x:Name="gridFolderTabs" Grid.Row="3" Margin="0,8,15,0"
                            Background="{DynamicResource BgPanel}" CornerRadius="8"
                            BorderBrush="{DynamicResource BorderMain}" BorderThickness="1"
                            Padding="3,3,3,3" Height="40" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Nút cuộn trái < -->
                            <Button x:Name="btnScrollTabsLeft" Grid.Column="0" Click="BtnScrollTabsLeft_Click"
                                    Width="24" Height="28" Margin="0,0,3,0" Padding="0"
                                    Style="{StaticResource MaterialDesignIconForegroundButton}"
                                    Visibility="Collapsed" ToolTip="Cuộn tab sang trái">
                                <materialDesign:PackIcon Kind="ChevronLeft" Width="18" Height="18" Foreground="{DynamicResource TextSecondary}"/>
                            </Button>

                            <ScrollViewer x:Name="scrollFolderTabs" Grid.Column="1"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                          PreviewMouseWheel="TabsScrollViewer_PreviewMouseWheel"
                                          ScrollChanged="ScrollFolderTabs_ScrollChanged"
                                          Focusable="False" PanningMode="HorizontalOnly">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Danh sách các Tab (Tất cả + Thư mục lẻ) -->
                                    <ItemsControl x:Name="itemsFolderTabs">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!-- Container cho mỗi Tab -->
                                                <Border Margin="0,0,4,0" Height="30" CornerRadius="6"
                                                        Cursor="Hand" ToolTip="{Binding ToolTipText}"
                                                        ContextMenuOpening="FolderTab_ContextMenuOpening"
                                                        MouseLeftButtonDown="FolderTab_MouseLeftButtonDown">
                                                    <Border.ContextMenu>
                                                        <ContextMenu ContextMenuOpening="FolderTab_ContextMenuOpening" Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderMain}">
                                                            <MenuItem Header="Thêm toàn bộ thư mục vào Playlist..." Click="MenuTabAddFolderToPlaylist_Click" Foreground="{DynamicResource TextPrimary}">
                                                                <MenuItem.Icon>
                                                                    <materialDesign:PackIcon Kind="PlaylistPlus" Foreground="{DynamicResource AccentPrimary}"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="Đổi tên thư mục..." Click="MenuTabRenameFolder_Click" Foreground="{DynamicResource TextPrimary}">
                                                                <MenuItem.Icon>
                                                                    <materialDesign:PackIcon Kind="RenameBox" Foreground="{DynamicResource AccentPrimary}"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="Cài đặt Equalizer (EQ)..." Click="MenuTabFolderEqualizer_Click" Foreground="{DynamicResource TextPrimary}">
                                                                <MenuItem.Icon>
                                                                    <materialDesign:PackIcon Kind="Equalizer" Foreground="{DynamicResource AccentPrimary}"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="Đóng thư mục này" Click="MenuTabCloseFolder_Click" Foreground="{DynamicResource TextPrimary}">
                                                                <MenuItem.Icon>
                                                                    <materialDesign:PackIcon Kind="Close" Foreground="{DynamicResource TextSecondary}"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                        </ContextMenu>
                                                    </Border.ContextMenu>
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <!-- Khi là Tab Tất cả thì không có context menu -->
                                                                <DataTrigger Binding="{Binding IsAllTab}" Value="True">
                                                                    <Setter Property="ContextMenu" Value="{x:Null}"/>
                                                                </DataTrigger>
                                                                <!-- Khi Tab được chọn (Active) -->
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource ControlBg}"/>
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
                                                                </DataTrigger>
                                                                <!-- Khi Hover chuột vào tab chưa chọn -->
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsSelected}" Value="False"/>
                                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Background" Value="{DynamicResource ItemHoverBg}"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>

                                                    <Grid VerticalAlignment="Center" Margin="8,0,8,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Icon Folder / All -->
                                                        <materialDesign:PackIcon Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0" Width="16" Height="16">
                                                            <materialDesign:PackIcon.Style>
                                                                <Style TargetType="materialDesign:PackIcon">
                                                                    <Setter Property="Kind" Value="FolderOutline"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsAllTab}" Value="True">
                                                                            <Setter Property="Kind" Value="FolderMultipleOutline"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </materialDesign:PackIcon.Style>
                                                        </materialDesign:PackIcon>

                                                        <!-- Tên Tab rõ nét, font 13px -->
                                                        <TextBlock Grid.Column="1" Text="{Binding HeaderName}" VerticalAlignment="Center" FontSize="13" MaxWidth="140" TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                                                    <Setter Property="FontWeight" Value="Medium"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                        <!-- Badge Mini hiển thị số lượng bài to rõ -->
                                                        <Border Grid.Column="2" Margin="6,0,0,0" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource ControlBg}"/>
                                                                    <Setter Property="BorderThickness" Value="1"/>
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource AccentPrimary}"/>
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding SongCount}" FontSize="11" FontWeight="Bold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                <Setter Property="Foreground" Value="White"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>

                                                        <!-- Icon Loa (🔊) khi Tab đang có bài hát phát -->
                                                        <materialDesign:PackIcon Grid.Column="3" Kind="VolumeHigh" Width="14" Height="14" Margin="5,0,0,0" VerticalAlignment="Center">
                                                            <materialDesign:PackIcon.Style>
                                                                <Style TargetType="materialDesign:PackIcon">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </materialDesign:PackIcon.Style>
                                                        </materialDesign:PackIcon>

                                                        <!-- Nút Close 'x' (chỉ hiện cho thư mục lẻ) -->
                                                        <Button Grid.Column="4" Click="BtnCloseTab_Click" Margin="5,0,0,0" Width="18" Height="18" Padding="0"
                                                                ToolTip="Đóng thư mục này">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconForegroundButton}">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsAllTab}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <materialDesign:PackIcon Kind="Close" Width="12" Height="12">
                                                                <materialDesign:PackIcon.Style>
                                                                    <Style TargetType="materialDesign:PackIcon">
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </materialDesign:PackIcon.Style>
                                                            </materialDesign:PackIcon>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Nút [+] Thêm Thư Mục -->
                                    <Button x:Name="btnAddFolderTab" Click="BtnFolder_Click"
                                            Width="28" Height="28" Margin="2,0,2,0" Padding="0"
                                            Style="{StaticResource MaterialDesignIconForegroundButton}"
                                            ToolTip="Mở thêm thư mục nhạc">
                                        <materialDesign:PackIcon Kind="FolderPlusOutline" Foreground="{DynamicResource TextSecondary}" Width="17" Height="17"/>
                                    </Button>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Nút cuộn phải > -->
                            <Button x:Name="btnScrollTabsRight" Grid.Column="2" Click="BtnScrollTabsRight_Click"
                                    Width="24" Height="28" Margin="3,0,0,0" Padding="0"
                                    Style="{StaticResource MaterialDesignIconForegroundButton}"
                                    Visibility="Collapsed" ToolTip="Cuộn tab sang phải">
                                <materialDesign:PackIcon Kind="ChevronRight" Width="18" Height="18" Foreground="{DynamicResource TextSecondary}"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Empty State khi chưa có bài hát hoặc thư mục nào -->
                    <Border x:Name="borderEmptyState" Grid.Row="4" Margin="0,12,15,12"
                            Background="{DynamicResource BgPanel}" CornerRadius="14"
                            BorderBrush="{DynamicResource BorderMain}" BorderThickness="1"
                            Visibility="Visible" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            Padding="24,20">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="56" Height="56" CornerRadius="28"
                                    Background="{DynamicResource ControlBg}"
                                    BorderBrush="{DynamicResource AccentPrimary}" BorderThickness="1.5"
                                    HorizontalAlignment="Center" Margin="0,0,0,12">
                                <materialDesign:PackIcon Kind="FolderMusicOutline" Width="28" Height="28"
                                                         Foreground="{DynamicResource AccentPrimary}"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock x:Name="txtEmptyTitle" Text="Chưa Có Thư Mục Nhạc Nào" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,6"/>

                            <TextBlock x:Name="txtEmptyDesc" Text="Thêm các thư mục chứa bài hát yêu thích của bạn để bắt đầu nghe nhạc"
                                       FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                       HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="360" TextWrapping="Wrap" Margin="0,0,0,16"/>

                            <Button Click="BtnEmptyStateAction_Click" Height="36" Padding="18,0"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Background="{DynamicResource AccentPrimary}" BorderThickness="0"
                                    Foreground="White" FontWeight="SemiBold" FontSize="12.5"
                                    HorizontalAlignment="Center" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon x:Name="iconEmptyAction" Kind="FolderOpenOutline" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="txtEmptyAction" Text="Mở Thư Mục Nhạc" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <ListBox x:Name="lstPlaylist" Grid.Row="4" Margin="0,10,0,0" Visibility="Collapsed" 
                             Background="Transparent" BorderThickness="0" 
                             Foreground="{DynamicResource TextPrimary}" FontSize="14" 
                             Padding="0"
                             SelectionChanged="LstPlaylist_SelectionChanged"
                             PreviewMouseLeftButtonUp="LstPlaylist_PreviewMouseLeftButtonUp"
                             PreviewMouseRightButtonDown="LstPlaylist_PreviewMouseRightButtonDown"
                             ContextMenuOpening="LstPlaylist_ContextMenuOpening"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="True" Cursor="Hand"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.ContextMenu>
                            <ContextMenu x:Name="ctxMenuPlaylist" Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderMain}">
                                <MenuItem x:Name="menuAddToPlaylist" Header="Thêm vào Playlist..." Click="MenuAddToPlaylist_Click" Foreground="{DynamicResource TextPrimary}">
                                    <MenuItem.Icon>
                                        <materialDesign:PackIcon Kind="PlaylistPlus" Foreground="{DynamicResource AccentPrimary}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="menuRemoveFromCurrentPlaylist" Header="Xóa khỏi Playlist này" Click="MenuRemoveFromCurrentPlaylist_Click" Foreground="#FF5252" Visibility="Collapsed">
                                    <MenuItem.Icon>
                                        <materialDesign:PackIcon Kind="PlaylistMinus" Foreground="#FF5252"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator Background="{DynamicResource BorderMain}"/>
                                <MenuItem Header="Mở thư mục chứa file" Click="MenuOpenFileLocation_Click" Foreground="{DynamicResource TextPrimary}">
                                    <MenuItem.Icon>
                                        <materialDesign:PackIcon Kind="FolderOpenOutline" Foreground="{DynamicResource TextSecondary}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Cài đặt Equalizer (EQ)..." Click="MenuEqualizerForSong_Click" Foreground="{DynamicResource TextPrimary}">
                                    <MenuItem.Icon>
                                        <materialDesign:PackIcon Kind="Equalizer" Foreground="{DynamicResource AccentPrimary}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Xem phổ âm thanh (Spectrogram)..." Click="MenuSpectrogramForSong_Click" Foreground="{DynamicResource TextPrimary}">
                                    <MenuItem.Icon>
                                        <materialDesign:PackIcon Kind="Waveform" Foreground="{DynamicResource AccentPrimary}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Xóa bài hát..." Click="MenuDeleteSong_Click" Foreground="{DynamicResource TextSecondary}">
                                    <MenuItem.Icon>
                                        <materialDesign:PackIcon Kind="TrashCanOutline" Foreground="{DynamicResource TextSecondary}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,12"/>
                                <Setter Property="Margin" Value="0,2,15,2"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Grid>
                                                <Border x:Name="HoverBg" Background="{DynamicResource ItemHoverBg}" CornerRadius="6" Opacity="0" />
                                                <Border x:Name="PlayingBg" Background="#332196F3" CornerRadius="6" Opacity="0" />
                                                <Border x:Name="SelectedBg" Background="#262196F3" CornerRadius="6" Opacity="0" />
                                                <Border CornerRadius="6">
                                                    <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                                </Border>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="HoverBg" Property="Opacity" Value="1"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                    <Setter TargetName="SelectedBg" Property="Visibility" Value="Collapsed"/>
                                                    <Setter TargetName="PlayingBg" Property="Opacity" Value="1"/>
                                                </DataTrigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="SelectedBg" Property="Opacity" Value="1"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <materialDesign:PackIcon x:Name="PlayingIcon" Grid.Column="0" Kind="VolumeHigh" 
                                        Width="18" Height="18" 
                                        Foreground="{DynamicResource AccentPrimary}" 
                                        VerticalAlignment="Center" Margin="0,0,12,0" 
                                        Visibility="Collapsed" />
                                        
                                    <TextBlock x:Name="SongText" Grid.Column="1" Text="{Binding DisplayName}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextPrimary}"/>
                                    
                                    <Button Grid.Column="2" Style="{StaticResource MaterialDesignIconForegroundButton}" 
                                            Width="24" Height="24" Click="BtnRemoveSong_Click" ToolTip="Xóa bài hát"
                                            Foreground="{DynamicResource TextMuted}">
                                        <materialDesign:PackIcon Kind="Close" Width="16" Height="16"/>
                                    </Button>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                        <Setter TargetName="PlayingIcon" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="SongText" Property="Foreground" Value="{DynamicResource AccentPrimary}"/>
                                        <Setter TargetName="SongText" Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>

            <!-- THANH ĐIỀU KHIỂN DƯỚI CÙNG -->
            <Border Grid.Row="2" Background="{DynamicResource BgPanel}" CornerRadius="0,0,15,15" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Timeline Full Width -->
                    <Slider x:Name="sliderTimeline" Grid.Row="0" Minimum="0" Maximum="100" Value="0" 
                            Foreground="{DynamicResource AccentPrimary}" Height="20" Margin="0,-10,0,0"
                            Thumb.DragStarted="SliderTimeline_DragStarted"
                            Thumb.DragCompleted="SliderTimeline_DragCompleted"
                            ValueChanged="SliderTimeline_ValueChanged"
                            IsMoveToPointEnabled="True"
                            Cursor="Hand"
                            materialDesign:SliderAssist.OnlyShowFocusVisualWhileDragging="True">
                        <Slider.Resources>
                            <Style TargetType="{x:Type Thumb}" BasedOn="{StaticResource {x:Type Thumb}}">
                                <Setter Property="LayoutTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.6" ScaleY="0.6"/>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Slider.Resources>
                    </Slider>

                    <!-- Cụm điều khiển -->
                    <Grid x:Name="bottomControlsGrid" Grid.Row="1" Margin="20,15,20,15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Trái: Thời gian -->
                        <StackPanel x:Name="pnlTime" Grid.Column="0" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock x:Name="txtCurrentTime" Text="00:00" Foreground="{DynamicResource TextSecondary}" FontSize="13" Margin="0,0,5,0" Width="40" TextAlignment="Right"/>
                            <TextBlock Text="/" Foreground="{DynamicResource TextMuted}" FontSize="13" Margin="0,0,5,0"/>
                            <TextBlock x:Name="txtTotalTime" Text="00:00" Foreground="{DynamicResource TextSecondary}" FontSize="13" Width="40"/>
                            
                            <Button Style="{StaticResource MaterialDesignIconForegroundButton}" ToolTip="Hẹn giờ tắt nhạc" Click="BtnSleepTimerToggle_Click" Margin="10,0,0,0" Width="30" Height="30">
                                <materialDesign:PackIcon x:Name="iconSleepTimer" Kind="TimerOutline" Foreground="{DynamicResource TextSecondary}" Width="18" Height="18"/>
                            </Button>
                            
                            <Popup x:Name="popupSleepTimer" StaysOpen="False" PlacementTarget="{Binding ElementName=iconSleepTimer}" Placement="Top" VerticalOffset="-10" AllowsTransparency="True">
                                <Border Background="{DynamicResource BgPanel}" CornerRadius="10" Padding="15" BorderThickness="1" BorderBrush="{DynamicResource AppBorder}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="15" ShadowDepth="5" Opacity="0.3" Color="Black"/>
                                    </Border.Effect>
                                    <Grid>
                                        <!-- GIAO DIỆN CHỌN HẸN GIỜ -->
                                        <StackPanel x:Name="pnlTimerSetup">
                                            <TextBlock Text="Hẹn giờ tắt nhạc" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                                            
                                            <TextBlock Text="Chọn nhanh" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>
                                            <Grid Margin="0,0,0,15">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Content="15'" Style="{StaticResource MaterialDesignPaperButton}" Height="36" Margin="0,0,4,0" Click="BtnTimer15_Click" Foreground="{DynamicResource TextPrimary}"/>
                                                <Button Grid.Column="1" Content="30'" Style="{StaticResource MaterialDesignPaperButton}" Height="36" Margin="4,0,4,0" Click="BtnTimer30_Click" Foreground="{DynamicResource TextPrimary}"/>
                                                <Button Grid.Column="2" Content="60'" Style="{StaticResource MaterialDesignPaperButton}" Height="36" Margin="4,0,0,0" Click="BtnTimer60_Click" Foreground="{DynamicResource TextPrimary}"/>
                                            </Grid>

                                            <TextBlock Text="Hoặc tùy chỉnh (phút)" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="txtCustomTimer" Grid.Column="0" Height="36" VerticalContentAlignment="Center" materialDesign:HintAssist.Hint="Ví dụ: 45" Foreground="{DynamicResource TextPrimary}" PreviewTextInput="TxtCustomTimer_PreviewTextInput"/>
                                                <Button Grid.Column="1" Content="Đặt giờ" Margin="10,0,0,0" Style="{StaticResource MaterialDesignFlatLightBgButton}" Height="36" Click="BtnSetCustomTimer_Click" Foreground="{DynamicResource AccentPrimary}"/>
                                            </Grid>
                                        </StackPanel>

                                        <!-- GIAO DIỆN ĐANG ĐẾM NGƯỢC -->
                                        <StackPanel x:Name="pnlTimerActive" Visibility="Collapsed" HorizontalAlignment="Center" Margin="10,5,10,5">
                                            <TextBlock Text="Đang hẹn giờ" FontSize="14" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                            
                                            <TextBlock x:Name="txtTimerCountdown" Text="00:15:00" FontSize="36" FontWeight="Light" Foreground="{DynamicResource AccentPrimary}" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                                            
                                            <Button Content="Hủy Hẹn Giờ" Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#e11d48" Foreground="#e11d48" Height="36" Click="BtnCancelTimer_Click" Width="150"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Popup>
                        </StackPanel>

                        <!-- Giữa: Controls -->
                        <Viewbox x:Name="viewboxControls" Grid.Column="1" Grid.Row="0" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel x:Name="pnlCenterControls" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="btnShuffle" Style="{StaticResource MaterialDesignIconButton}" 
                                        Width="35" Height="35" Margin="5,0,10,0" Foreground="{DynamicResource TextSecondary}" Click="BtnShuffle_Click" ToolTip="Phát ngẫu nhiên" Cursor="Hand">
                                    <materialDesign:PackIcon x:Name="iconShuffle" Kind="ShuffleVariant" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>

                                <!-- Nút Prev -->
                                <Button x:Name="btnPrev" Style="{StaticResource MaterialDesignFloatingActionMiniButton}" 
                                        Width="36" Height="36" Margin="0,0,10,0" Background="{DynamicResource ControlBg}" BorderBrush="Transparent" Click="BtnPrev_Click" Cursor="Hand">
                                    <materialDesign:PackIcon Kind="SkipPrevious" Width="20" Height="20" Foreground="{DynamicResource TextPrimary}"/>
                                </Button>

                                <!-- Nút Lùi 10s -->
                                <Button x:Name="btnRewind" Style="{StaticResource MaterialDesignFloatingActionMiniButton}" 
                                        Width="36" Height="36" Margin="0,0,10,0" Background="{DynamicResource ControlBg}" BorderBrush="Transparent" Click="BtnRewind_Click" Cursor="Hand">
                                    <materialDesign:PackIcon Kind="Rewind10" Width="20" Height="20" Foreground="{DynamicResource TextPrimary}"/>
                                </Button>

                                <!-- Nút Play/Pause -->
                                <Button x:Name="btnPlayPause" Style="{StaticResource MaterialDesignFloatingActionMiniButton}" 
                                        Width="46" Height="46" Margin="0,0,10,0" Background="{DynamicResource AccentPrimary}" BorderBrush="Transparent" Click="BtnPlayPause_Click" Cursor="Hand">
                                    <materialDesign:PackIcon x:Name="iconPlayPause" Kind="Play" Width="28" Height="28" Foreground="White"/>
                                </Button>

                                <!-- Nút Tua 10s -->
                                <Button x:Name="btnFastForward" Style="{StaticResource MaterialDesignFloatingActionMiniButton}" 
                                        Width="36" Height="36" Margin="0,0,10,0" Background="{DynamicResource ControlBg}" BorderBrush="Transparent" Click="BtnFastForward_Click" Cursor="Hand">
                                    <materialDesign:PackIcon Kind="FastForward10" Width="20" Height="20" Foreground="{DynamicResource TextPrimary}"/>
                                </Button>

                                <!-- Nút Next -->
                                <Button x:Name="btnNext" Style="{StaticResource MaterialDesignFloatingActionMiniButton}" 
                                        Width="36" Height="36" Margin="0,0,10,0" Background="{DynamicResource ControlBg}" BorderBrush="Transparent" Click="BtnNext_Click" Cursor="Hand">
                                    <materialDesign:PackIcon Kind="SkipNext" Width="20" Height="20" Foreground="{DynamicResource TextPrimary}"/>
                                </Button>

                                <!-- Nút Repeat -->
                                <Button x:Name="btnRepeat" Style="{StaticResource MaterialDesignIconForegroundButton}" 
                                        Width="35" Height="35" Margin="5,0,0,0" Foreground="{DynamicResource TextSecondary}" Click="BtnRepeat_Click" ToolTip="Lặp lại bài hát" Cursor="Hand">
                                    <materialDesign:PackIcon x:Name="iconRepeat" Kind="Repeat" Width="20" Height="20"/>
                                </Button>
                            </StackPanel>
                        </Viewbox>

                        <!-- Phải: Tốc độ phát & Volume -->
                        <StackPanel x:Name="pnlVolume" Grid.Column="2" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <!-- Nút Tốc độ phát -->
                            <Button x:Name="btnPlaybackSpeed" Style="{StaticResource MaterialDesignFlatButton}" 
                                    Height="28" Padding="4,2" Margin="0,0,8,0"
                                    Foreground="{DynamicResource TextSecondary}" Click="BtnPlaybackSpeed_Click" 
                                    ToolTip="Tốc độ phát nhạc" Cursor="Hand">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Speedometer" Width="16" Height="16" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="txtPlaybackSpeed" Text="1.0x" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Popup chọn Tốc độ phát -->
                            <Popup x:Name="popupPlaybackSpeed" StaysOpen="False" PlacementTarget="{Binding ElementName=btnPlaybackSpeed}" Placement="Top" VerticalOffset="-10" AllowsTransparency="True">
                                <Border Background="{DynamicResource BgPanel}" CornerRadius="12" Padding="14,12" BorderThickness="1" BorderBrush="{DynamicResource AppBorder}" MinWidth="220">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="18" ShadowDepth="6" Opacity="0.35" Color="Black"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <!-- Header -->
                                        <Grid Margin="0,0,0,10">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="Speedometer" Width="16" Height="16" Foreground="{DynamicResource AccentPrimary}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Tốc độ phát" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Button Style="{StaticResource MaterialDesignIconForegroundButton}" Width="24" Height="24" HorizontalAlignment="Right" Click="BtnResetSpeed_Click" ToolTip="Đặt lại chuẩn (1.0x)">
                                                <materialDesign:PackIcon Kind="Restart" Width="14" Height="14" Foreground="{DynamicResource TextMuted}"/>
                                            </Button>
                                        </Grid>

                                        <!-- Mốc tốc độ nhanh -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Hàng 1 -->
                                            <Button Grid.Row="0" Grid.Column="0" Content="0.25x" Style="{StaticResource MaterialDesignPaperButton}" Height="30" FontSize="11" Margin="2" Click="BtnSpeedPreset_Click" Tag="0.25" Foreground="{DynamicResource TextPrimary}"/>
                                            <Button Grid.Row="0" Grid.Column="1" Content="0.5x" Style="{StaticResource MaterialDesignPaperButton}" Height="30" FontSize="11" Margin="2" Click="BtnSpeedPreset_Click" Tag="0.5" Foreground="{DynamicResource TextPrimary}"/>
                                            <Button Grid.Row="0" Grid.Column="2" Content="0.75x" Style="{StaticResource MaterialDesignPaperButton}" Height="30" FontSize="11" Margin="2" Click="BtnSpeedPreset_Click" Tag="0.75" Foreground="{DynamicResource TextPrimary}"/>
                                            <Button Grid.Row="0" Grid.Column="3" Content="1.0x" Style="{StaticResource MaterialDesignPaperButton}" Height="30" FontSize="11" Margin="2" Click="BtnSpeedPreset_Click" Tag="1.0" Foreground="{DynamicResource AccentPrimary}" FontWeight="Bold"/>

                                            <!-- Hàng 2 -->
                                            <Button Grid.Row="1" Grid.Column="0" Content="1.25x" Style="{StaticResource MaterialDesignPaperButton}" Height="30" FontSize="11" Margin="2" Click="BtnSpeedPreset_Click" Tag="1.25" Foreground="{DynamicResource TextPrimary}"/>
                                            <Button Grid.Row="1" Grid.Column="1" Content="1.5x" Style="{StaticResource MaterialDesignPaperButton}" Height="30" FontSize="11" Margin="2" Click="BtnSpeedPreset_Click" Tag="1.5" Foreground="{DynamicResource TextPrimary}"/>
                                            <Button Grid.Row="1" Grid.Column="2" Content="1.75x" Style="{StaticResource MaterialDesignPaperButton}" Height="30" FontSize="11" Margin="2" Click="BtnSpeedPreset_Click" Tag="1.75" Foreground="{DynamicResource TextPrimary}"/>
                                            <Button Grid.Row="1" Grid.Column="3" Content="2.0x" Style="{StaticResource MaterialDesignPaperButton}" Height="30" FontSize="11" Margin="2" Click="BtnSpeedPreset_Click" Tag="2.0" Foreground="{DynamicResource TextPrimary}"/>
                                        </Grid>

                                        <!-- Thanh tùy chỉnh tốc độ -->
                                        <Border Background="{DynamicResource ControlBg}" CornerRadius="8" Padding="10,6">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,4">
                                                    <TextBlock Text="Tùy chỉnh" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="txtCustomSpeedVal" Text="1.00x" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                                <Slider x:Name="sliderCustomSpeed" Minimum="0.25" Maximum="2.5" Value="1.0" SmallChange="0.05" LargeChange="0.25"
                                                        Foreground="{DynamicResource AccentPrimary}" Cursor="Hand"
                                                        ValueChanged="SliderCustomSpeed_ValueChanged"
                                                        materialDesign:SliderAssist.OnlyShowFocusVisualWhileDragging="True">
                                                    <Slider.Resources>
                                                        <Style TargetType="{x:Type Thumb}" BasedOn="{StaticResource {x:Type Thumb}}">
                                                            <Setter Property="LayoutTransform">
                                                                <Setter.Value>
                                                                    <ScaleTransform ScaleX="0.6" ScaleY="0.6"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </Slider.Resources>
                                                </Slider>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Popup>

                            <!-- Volume Slider -->
                            <materialDesign:PackIcon Kind="VolumeHigh" Width="20" Height="20" Foreground="{DynamicResource TextSecondary}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <Slider x:Name="sliderVolume" Width="100" Minimum="0" Maximum="100" Value="50" Cursor="Hand"
                                    Foreground="{DynamicResource AccentPrimary}" VerticalAlignment="Center"
                                    materialDesign:SliderAssist.OnlyShowFocusVisualWhileDragging="True" ValueChanged="SliderVolume_ValueChanged">
                                <Slider.Resources>
                                    <Style TargetType="{x:Type Thumb}" BasedOn="{StaticResource {x:Type Thumb}}">
                                        <Setter Property="LayoutTransform">
                                            <Setter.Value>
                                                <ScaleTransform ScaleX="0.6" ScaleY="0.6"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Slider.Resources>
                            </Slider>
                            <TextBlock x:Name="txtVolumePercent" Text="50%" Foreground="{DynamicResource TextSecondary}" FontSize="13" Margin="5,0,0,0" Width="35" TextAlignment="Right" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
